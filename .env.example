# Copy to .env and fill in. .env is gitignored; this file is not — never put a
# real secret here.
#
# Roots are normally resolved from settings/paths.toml. These variables are the
# fallback for a root that has no literal path there, and the override for
# running on a machine the toml knows nothing about. The name is always
# LABCORE_<ROOT>_ROOT, uppercased from the key under [roots].

LABCORE_DATA_ROOT=
LABCORE_OUTPUTS_ROOT=

# Registry credentials for pushing dev images, if you build any. Read by docker
# login, never by project code.
DOCKER_USERNAME=
DOCKER_TOKEN=
