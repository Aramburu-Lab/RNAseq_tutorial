{# M6's live ORA (WO7): another contrast's calls against its own tested genes, and the sets
   drawn, those that pass or each family's smallest FDR; ctxOra reruns lite.ora on them. #}
<label>{{ w.contrast }}<select name="contrast">{% for name, label, _, _ in f.defaults.contrasts %}<option value="{{ name }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>{{ w.sets }}<select name="sets"><option value="passing" selected>{{ w.sets_passing }}</option><option value="top">{{ w.sets_top.format(top=f.defaults.top) }}</option></select></label>
