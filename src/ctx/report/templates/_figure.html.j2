{% macro figure_block(f, standalone=false, tab=false) %}
<figure class="fig" id="figure-{{ f.number }}"{% if tab %} role="tabpanel" aria-labelledby="tab-{{ f.number }}"{% endif %}>
{% if not standalone %}
<p class="fig-num">{{ ui.figure_n.format(n=f.number) }}</p>
{% if f.title %}<h{{ f.level }} class="fig-title">{{ f.title }}</h{{ f.level }}>{% endif %}
{% endif %}
{% if f.lead %}<p class="fig-lead">{{ f.lead }}</p>{% endif %}
{% if f.kind == "brush" %}
<form class="brush" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="{{ ui.brush.label }}">
<fieldset><legend>{{ ui.brush.colour }}</legend>{% for hex, name in f.defaults.colours %}<label class="paint"><input type="radio" name="colour" value="{{ loop.index0 }}"{% if loop.first %} checked{% endif %}><span class="sw" style="--sw: {{ hex }}"></span>{{ name }}</label>{% endfor %}</fieldset>
<button type="button" data-clear>{{ ui.brush.erase }}</button>
<p class="brush-how">{{ ui.brush.how }}</p>
</form>
<noscript><p class="note">{{ ui.brush.noscript }}</p></noscript>
<p class="brush-summary" aria-live="polite">{{ f.defaults.empty }}</p>
{% endif %}
{% if f.kind == "calls" %}
<form class="calls" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="{{ ui.calls.label }}">
<label>{{ ui.calls.fc }}<span class="pair"><input name="fc" type="number" min="0" step="any" value="{{ f.defaults.fc }}" aria-label="{{ ui.calls.fc_input }}"><select name="fc_unit" aria-label="{{ ui.calls.fc_unit }}"><option value="log2" selected>{{ ui.calls.log2 }}</option><option value="pct">{{ ui.calls.pct }}</option></select></span></label>
<label>{{ ui.calls.basis }}<select name="basis">{% for column, words in f.defaults.bases %}<option value="{{ column }}"{% if loop.first %} selected{% endif %}>{{ words }}</option>{% endfor %}</select></label>
<label>{{ ui.calls.cutoff }}<span class="pair"><input name="cutoff" type="text" inputmode="decimal" autocomplete="off" value="{{ f.defaults.alpha }}" aria-label="{{ ui.calls.cutoff_input.format(presets=f.defaults.presets | join(', ')) }}"><button type="button" data-step="-1" aria-label="{{ ui.calls.stricter }}" title="{{ ui.calls.stricter }}">&#9660;</button><button type="button" data-step="1" aria-label="{{ ui.calls.looser }}" title="{{ ui.calls.looser }}">&#9650;</button></span></label>
<button type="reset">{{ ui.calls.reset }}</button>
</form>
<noscript><p class="note">{{ ui.calls.noscript }}</p></noscript>
<p class="calls-summary" aria-live="polite">{{ f.defaults.summary }}</p>
{% if f.select %}{% set w = f.select.words %}
{# The gene picker (GS.4): a lasso, a box or a click on the volcano, the table, the paste box;
   the page script fills the table, the count and the links' lists. #}
<form class="calls select" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="{{ w.label }}">
<fieldset><legend>{{ w.drag }}</legend>{% for value in ("zoom", "select", "lasso") %}<label class="paint"><input type="radio" name="drag" value="{{ value }}"{% if loop.first %} checked{% endif %}>{{ w[("zoom", "box", "lasso")[loop.index0]] }}</label>{% endfor %}</fieldset>
<fieldset><legend>{{ w.mode }}</legend>{% for value in ("replace", "add", "remove") %}<label class="paint"><input type="radio" name="mode" value="{{ value }}"{% if loop.first %} checked{% endif %}>{{ w[value] }}</label>{% endfor %}</fieldset>
<p class="pick-buttons"><button type="button" data-pick="up">{{ w.up }}</button><button type="button" data-pick="down">{{ w.down }}</button><button type="button" data-undo disabled>{{ w.undo }}</button><button type="button" data-clear-list>{{ w.clear_list }}</button></p>
<label class="genes">{{ w.paste }}<textarea name="pasted" rows="2" spellcheck="false" autocomplete="off"></textarea></label><button type="button" data-paste>{{ w.paste_button }}</button>
</form>
<noscript><p class="note">{{ w.noscript }}</p></noscript>
<p class="select-count calls-summary" aria-live="polite">{{ w.count_none }}</p>
<p class="select-problems" aria-live="polite" hidden></p>
<div class="pick-table js-only"><p class="pick-find"><label>{{ w.search }} <input type="search" name="find" autocomplete="off"></label> <label><input type="checkbox" name="only"> {{ w.only }}</label></p>
<div class="table-scroll"><table class="result-table pick"><thead><tr><th>{{ w.columns.pick }}</th>{% for key in ("symbol", "lfc", "padj", "call") %}<th{% if key in ("lfc", "padj") %} class="num"{% endif %}><button type="button" data-sort="{{ key }}">{{ w.columns[("gene", "lfc", "padj", "call")[loop.index0]] }}</button></th>{% endfor %}</tr></thead><tbody></tbody></table></div>
<p class="pick-pages"><button type="button" data-page="-1">{{ w.previous }}</button> <span aria-live="polite"></span> <button type="button" data-page="1">{{ w.next }}</button></p></div>
<p class="pick-leave js-only"><button type="button" data-copy-list>{{ w.copy_list }}</button> <button type="button" data-save-list>{{ w.save_list }}</button></p>
<pre class="pick-list" hidden></pre>
{% if f.select.links %}<ul class="pick-links js-only">{% for href, module in f.select.links %}<li><a href="{{ href }}" data-onward="{{ module }}">{{ w.onward_none.format(module=module) }}</a> <button type="button" data-beside="{{ loop.index0 }}">{{ w.beside }}</button></li>{% endfor %}</ul>{% endif %}
<p class="select-notice" hidden>{{ w.notice }}</p>
{% endif %}
{% endif %}
{% if f.kind == "filter" %}
{# Class "calls" for the panel's look only; the page script tells the two kinds apart. #}
<form class="calls filter" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="{{ ui.filter.label }}">
{% for column, levels, label in f.defaults.filters %}<label>{{ label }}<select data-column="{{ column }}"><option value="" selected>{{ ui.filter.all }}</option>{% for level in levels %}<option value="{{ level }}">{{ level }}</option>{% endfor %}</select></label>{% endfor %}
</form>
<noscript><p class="note">{{ ui.filter.noscript }}</p></noscript>
<p class="calls-summary filter-summary" aria-live="polite" data-template="{{ f.defaults.template }}" data-none="{{ f.defaults.none }}">{{ f.defaults.summary }}</p>
{% endif %}
{% if f.kind == "ora" %}{% set w = f.defaults.words %}
{# M6's live over-representation (GS.5): the reader's list against a background, rerun in
   the page by ctxOra; the bars below are the sets that pass. #}
<form class="calls ora" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ w.label }}">
<label>{{ w.direction }}<select name="direction">{% for value, label in w.directions.items() %}<option value="{{ value }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>{{ w.background }}<select name="background">{% for key, label, _, size in f.defaults.backgrounds %}<option value="{{ key }}"{% if key == f.defaults.featured %} selected{% endif %}>{{ label }} ({{ "{:,}".format(size) }})</option>{% endfor %}</select></label>
<label class="genes">{{ w.paste }}<textarea name="pasted" rows="2" spellcheck="false" autocomplete="off"></textarea></label>
<button type="button" data-paste>{{ w.paste_button }}</button>
<button type="button" data-reset>{{ w.reset }}</button>
</form>
<noscript><p class="note">{{ w.noscript }}</p></noscript>
<p class="calls-summary ora-summary" aria-live="polite"></p>
<p class="ora-notes" aria-live="polite"></p>
<p class="pick-leave js-only"><button type="button" data-copy-tsv>{{ w.copy_table }}</button></p>
<pre class="ora-tsv" hidden></pre>
{% endif %}
{% if f.kind == "view" %}
{# A select between figures Python drew (D-051 view kind); the first is the figure as built. #}
<form class="calls view" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ f.defaults.label }}">
<label>{{ f.defaults.label }}<select name="view">{% for label in f.defaults.options %}<option value="{{ loop.index0 }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
</form>
<noscript><p class="note">{{ ui.view.noscript }}</p></noscript>
<p class="calls-summary view-summary" aria-live="polite"></p>
{% endif %}
{% if f.kind == "subset" %}{% set w = f.defaults.words %}
{# M9's checkbox sets (E.1a): F3's lineages and tau's scale, F4's tissues; ctxM9 retakes the
   panel over what is ticked. #}
<form class="calls subset" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="{{ w.label }}">
<fieldset><legend>{{ w.legend }}</legend>{% for option in f.defaults.options %}<label class="paint"><input type="checkbox" name="kept" value="{{ option }}" checked>{{ option }}</label>{% endfor %}</fieldset>
{% if f.defaults.scales %}<label>{{ w.scale }}<select name="scale">{% for value, label in f.defaults.scales %}<option value="{{ value }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
</form>
<noscript><p class="note">{{ ui.subset.noscript }}</p></noscript>
<p class="calls-summary subset-summary" aria-live="polite">{{ f.defaults.summary }}</p>
{% endif %}
{% if f.kind == "recount" %}{% set w = f.defaults.words %}
{# M1 Figure 1 (work-order item 5): a contrast's runs, a colour, a count; ctxRecount recounts. #}
<form class="calls recount" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ w.contrast }}">
<label>{{ w.contrast }}<select name="contrast"><option value="" selected>{{ w.every }}</option>{% for label in f.defaults.contrasts %}<option value="{{ loop.index0 }}">{{ label }}</option>{% endfor %}</select></label>
<label>{{ w.colour }}<select name="colour">{% for column in f.defaults.colours %}<option value="{{ column }}"{% if loop.first %} selected{% endif %}>{{ column }}</option>{% endfor %}</select></label>
<label>{{ w.count }}<select name="count">{% for value, label in w.counts.items() %}<option value="{{ value }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
</form>
<noscript><p class="note">{{ w.noscript }}</p></noscript>
<p class="calls-summary recount-summary" aria-live="polite">{{ f.defaults.summary }}</p>
{% endif %}
{% if f.kind == "judge" %}{% set w = f.defaults.words %}
{# M2's judge panel (work-order item 5): every strip of one scope moves with it; ctxJudge judges. #}
<form class="calls judge" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ w.label }}">
<label>{{ w.k }}<select name="k">{% for value, label in f.defaults.ks %}<option value="{{ value }}"{% if value == f.defaults.k %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>{{ w.strata }}<select name="strata">{% for label in f.defaults.strata %}<option value="{{ loop.index0 }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
{% if f.defaults.peers %}<label>{{ w.peers }}<select name="peers">{% for label in f.defaults.peers %}<option value="{{ loop.index0 }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
</form>
<noscript><p class="note">{{ w.noscript }}</p></noscript>
<p class="calls-summary judge-summary" aria-live="polite"></p>
{% endif %}
{% if f.kind == "pairs" %}
<form class="calls pairs" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ ui.pairs.label }}">
<label>{{ f.defaults.label or ui.pairs.pair }}<select name="pair">{% for value, label in f.defaults.options %}<option value="{{ value }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
</form>
<noscript><p class="note">{{ ui.pairs.noscript }}</p></noscript>
<p class="calls-summary pairs-summary" aria-live="polite">{{ f.defaults.summary }}</p>
{% endif %}
{% if f.kind == "survival" %}
<form class="survival" data-controls="ctx-controls-{{ f.index }}" aria-label="{{ ui.survival.label }}">
<label>{{ ui.survival.endpoint }}<select name="endpoint">{% for value, label in f.defaults.endpoints %}<option value="{{ value }}"{% if value == f.defaults.endpoint %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>{{ ui.survival.split }}<select name="split">{% for value, label in f.defaults.splits %}<option value="{{ value }}"{% if value == f.defaults.split %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label class="genes">{{ ui.survival.genes }}<textarea name="genes" rows="3" spellcheck="false" autocomplete="off" aria-describedby="ctx-genes-hint-{{ f.index }}">{{ f.defaults.genes }}</textarea><span class="hint" id="ctx-genes-hint-{{ f.index }}">{{ ui.survival.genes_hint }}</span></label>
<button type="submit">{{ ui.survival.score }}</button>
<button type="button" data-screen>{{ ui.survival.screen.format(rows=f.defaults.screen_rows) }}</button>
<button type="button" data-undo disabled>{{ ui.survival.undo }}</button>
<button type="button" data-reset>{{ ui.survival.reset }}</button>
</form>
<noscript><p class="note">{{ ui.survival.noscript }}</p></noscript>
<p class="survival-summary" aria-live="polite">{{ f.defaults.summary }}</p>
<p class="survival-notes" aria-live="polite">{{ f.defaults.notice }} {{ f.defaults.panel }}</p>
{% endif %}
<div class="fig-body{% if f.text.reading %} has-reading{% endif %}">
<div class="fig-plot"><p class="scroll-hint" hidden>{{ ui.figures.scroll }}</p>{{ f.html }}</div>
{% if f.text.reading %}
<aside class="reading" aria-label="{{ ui.figures.reading_label }}"><p class="reading-title">{{ ui.figures.reading }}</p><ul>
{% for line in f.text.reading %}<li{% if f.kind == "calls" %} data-reading="{{ loop.index0 }}"{% endif %}>{{ line | code }}</li>
{% endfor %}</ul></aside>
{% endif %}
</div>
{% if f.below %}<div class="fig-below"><p class="scroll-hint" hidden>{{ ui.figures.scroll }}</p>{{ f.below }}</div>
{% endif %}
<figcaption>{{ f.caption | explain_terms("results") }}</figcaption>
<p class="fig-files">{% if f.page and not standalone %}<a href="{{ f.page }}">{{ ui.figures.open }}</a>{% endif %}{% for label, theme, href in f.files %}<a{% if theme %} class="only-{{ theme }}"{% endif %} href="{{ href }}"{% if f.export and theme %} title="{{ ui.export.reference }}" data-export="{{ href.rsplit('.', 1)[1] }}" data-view="{{ ui.export.view.format(kind=label) }}" data-view-title="{{ ui.export.view_title }}"{% endif %}>{{ label }}</a>{% endfor %}</p>
{% if f.controls %}<script type="application/json" id="ctx-controls-{{ f.index }}">{{ f.controls }}</script>
{% endif %}
<script type="application/json" id="ctx-data-{{ f.index }}">{{ f.rows }}</script>
</figure>
{% endmacro %}
{% macro panel_block(p) %}{% set w = p.defaults.words %}
{# M9's list from a link (E.1a): the page script fills the line, the table and the command. #}
<div class="genelist-panel">
<form class="calls genelist" data-controls="ctx-panel-{{ p.index }}" aria-label="{{ w.label }}">
<label>{{ w.contrast }}<select name="contrast"><option value="">{{ w.every }}</option>{% for value, label in p.defaults.contrasts %}<option value="{{ value }}"{% if value == p.defaults.featured %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label class="genes">{{ w.paste }}<textarea name="pasted" rows="2" spellcheck="false" autocomplete="off"></textarea></label><button type="button" data-paste>{{ w.paste_button }}</button>
</form>
<noscript><p class="note">{{ w.noscript }}</p></noscript>
<p class="calls-summary list-summary" aria-live="polite">{{ w.waiting }}</p>
<p class="list-notes" aria-live="polite"></p>
{# The live heatmap of the list (E.1d): drawn by the page script from the evidence it carries. #}
<figure class="fig list-heat js-only" hidden><p class="fig-title">{{ w.heat_label }}</p><div class="fig-plot"><p class="scroll-hint" hidden>{{ ui.figures.scroll }}</p><div class="list-heat-plot"></div></div><figcaption class="list-heat-caption"></figcaption><p class="note">{{ w.heat_files }}</p></figure>
<div class="pick-table js-only" hidden><div class="table-scroll"><table class="result-table pick list"><caption>{{ w.rounded }}</caption><thead><tr></tr></thead><tbody></tbody></table></div>
<p class="pick-pages"><button type="button" data-page="-1">{{ w.previous }}</button> <span aria-live="polite"></span> <button type="button" data-page="1">{{ w.next }}</button></p></div>
<figure class="code list-command" hidden><figcaption>{{ w.command }}</figcaption><div class="command"><pre><code id="ctx-list-command-{{ p.index }}"></code></pre><button type="button" class="copy" data-copy="ctx-list-command-{{ p.index }}" data-copied="{{ ui.reproduce.copied }}" data-selected="{{ ui.reproduce.selected }}">{{ ui.reproduce.button }}</button></div></figure>
<script type="application/json" id="ctx-panel-{{ p.index }}">{{ p.controls }}</script>
</div>
{% endmacro %}
{% macro result_table(t) %}
<div class="table-scroll"><table class="result-table{% if t.css %} {{ t.css }}{% endif %}">
{% if t.title %}<caption>{{ t.title }}</caption>{% endif %}
<thead><tr>{% for c in t.columns %}<th{% if loop.index0 in t.numeric %} class="num"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in t.rows %}<tr>{% for cell in row %}<td{% if loop.index0 in t.numeric %} class="num"{% endif %}>{% if loop.index0 == t.swatch %}<span class="sw" style="--sw: {{ cell }}"></span>{% endif %}{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</tbody>
</table></div>
{% endmacro %}
