{% macro figure_block(f, standalone=false, tab=false) %}
<figure class="fig" id="figure-{{ f.number }}"{% if tab %} role="tabpanel" aria-labelledby="tab-{{ f.number }}"{% endif %}>
{% if not standalone %}
<p class="fig-num">Figure {{ f.number }}</p>
{% if f.title %}<h{{ f.level }} class="fig-title">{{ f.title }}</h{{ f.level }}>{% endif %}
{% endif %}
{% if f.text.lead %}<p class="fig-lead">{{ f.text.lead }}</p>{% endif %}
{% if f.controls %}
<form class="calls" data-controls="ctx-controls-{{ f.index }}" data-rows="ctx-data-{{ f.index }}" aria-label="Cutoffs for calling genes">
<label>Fold change at least<span class="pair"><input name="fc" type="number" min="0" step="any" value="{{ f.defaults.fc }}" aria-label="Fold-change threshold"><select name="fc_unit" aria-label="Fold-change unit"><option value="log2" selected>log2 FC</option><option value="pct">% change</option></select></span></label>
<label>Significance<select name="basis">{% for column, words in f.defaults.bases %}<option value="{{ column }}"{% if loop.first %} selected{% endif %}>{{ words }}</option>{% endfor %}</select></label>
<label>Below<input name="cutoff" type="number" min="{{ f.defaults.min_cutoff }}" max="{{ f.defaults.max_cutoff }}" step="any" value="{{ f.defaults.alpha }}" list="cutoffs-{{ f.index }}"></label>
<datalist id="cutoffs-{{ f.index }}">{% for c in f.defaults.presets %}<option value="{{ c }}"></option>{% endfor %}</datalist>
<button type="reset">Reset</button>
</form>
<noscript><p class="note">This is the default rule; turn on JavaScript to move the cutoffs.</p></noscript>
<p class="calls-summary" aria-live="polite">{{ f.defaults.summary }}</p>
{% endif %}
<div class="fig-body{% if f.text.reading %} has-reading{% endif %}">
<div class="fig-plot">{{ f.html }}</div>
{% if f.text.reading %}
<aside class="reading" aria-label="How to read this figure"><p class="reading-title">How to read this</p><ul>
{% for line in f.text.reading %}<li{% if f.controls %} data-reading="{{ loop.index0 }}"{% endif %}>{{ line }}</li>
{% endfor %}</ul></aside>
{% endif %}
</div>
<figcaption>{{ f.caption }}</figcaption>
<p class="fig-files">{% if f.page and not standalone %}<a href="{{ f.page }}">Open alone</a>{% endif %}{% for label, theme, href in f.files %}<a{% if theme %} class="only-{{ theme }}"{% endif %} href="{{ href }}">{{ label }}</a>{% endfor %}</p>
{% if f.controls %}<script type="application/json" id="ctx-controls-{{ f.index }}">{{ f.controls }}</script>
{% endif %}
<script type="application/json" id="ctx-data-{{ f.index }}">{{ f.rows }}</script>
</figure>
{% endmacro %}
{% macro result_table(t) %}
<div class="table-scroll"><table class="result-table">
{% if t.title %}<caption>{{ t.title }}</caption>{% endif %}
<thead><tr>{% for c in t.columns %}<th{% if loop.index0 in t.numeric %} class="num"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in t.rows %}<tr>{% for cell in row %}<td{% if loop.index0 in t.numeric %} class="num"{% endif %}>{% if loop.index0 == t.swatch %}<span class="sw" style="--sw: {{ cell }}"></span>{% endif %}{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</tbody>
</table></div>
{% endmacro %}
