/* M6's live over-representation (GS.5), the page twin of ctx.function.lite.ora, apart from the
   page so tests/test_ora_page.py runs it against lite.ora under node. The same order: the
   universe is the background; the hits are cut to it; each set is cut to it, then kept at
   min to max genes; P(X >= k) is hypergeom.sf(k - 1, N, K, n); BH runs over the kept sets. */
var ctxOra = {
  /* log(i!) for i up to n, by running sums of logs, compensated (Kahan): a plain running sum
     drifted 2.6e-10 in p from lite.ora on Step-1, over D-049's 1.52e-10. */
  logFactorials: function (n) {
    var out = new Float64Array(n + 1), sum = 0, lost = 0;
    for (var i = 1; i <= n; i++) {
      var y = Math.log(i) - lost, t = sum + y;
      lost = (t - sum) - y; sum = t; out[i] = sum;
    }
    return out;
  },
  /* P(X >= k) for X hypergeometric: n drawn from N holding K, summed over the upper tail
     from its largest term, so a small p keeps its digits. */
  upper: function (k, N, K, n, lf) {
    var lo = Math.max(k, 0, n - (N - K)), hi = Math.min(K, n);
    if (lo > hi) return 0;
    function choose(a, b) { return lf[a] - lf[b] - lf[a - b]; }
    var whole = choose(N, n), terms = [], top = -Infinity;
    for (var x = lo; x <= hi; x++) {
      var t = choose(K, x) + choose(N - K, n - x) - whole;
      terms.push(t);
      if (t > top) top = t;
    }
    var sum = 0;
    terms.forEach(function (t) { sum += Math.exp(t - top); });
    return Math.min(1, Math.exp(top) * sum);
  },
  /* scipy.stats.false_discovery_control(method="bh"): p times m over its rank, the running
     minimum from the largest p down, at most 1; in the order given. */
  bh: function (ps) {
    var m = ps.length, order = ps.map(function (_, i) { return i; });
    order.sort(function (a, b) { return ps[a] - ps[b] || a - b; });
    var out = new Array(m), low = 1;
    for (var r = m - 1; r >= 0; r--) {
      var i = order[r];
      low = Math.min(low, ps[i] * m / (r + 1));
      out[i] = low;
    }
    return out;
  },
  /* lite.ora: hits and background as gene names, sets as [name, genes] in order. */
  ora: function (hits, background, sets, minSize, maxSize, lf) {
    var universe = Object.create(null), drawn = Object.create(null), N = 0, n = 0;
    background.forEach(function (g) { if (!universe[g]) { universe[g] = true; N++; } });
    hits.forEach(function (g) { if (universe[g] && !drawn[g]) { drawn[g] = true; n++; } });
    lf = lf || ctxOra.logFactorials(N);
    var rows = [];
    sets.forEach(function (pair) {
      var genes = pair[1].filter(function (g) { return universe[g]; });
      if (genes.length < minSize || genes.length > maxSize) return;
      var overlap = genes.filter(function (g) { return drawn[g]; });
      rows.push({ name: pair[0], size: genes.length, hits: overlap.length,
                  expected: n * genes.length / N,
                  p: ctxOra.upper(overlap.length, N, genes.length, n, lf), genes: overlap });
    });
    var fdr = ctxOra.bh(rows.map(function (r) { return r.p; }));
    rows.forEach(function (r, i) { r.fdr = fdr[i]; });
    return rows;
  },
  /* ctx.function.live.drawn (PK.3): one family's bars, in order, each marked. The same order:
     drop the sets holding none of the list, sort by p, a tie by set name (code-point order,
     as Python sorts), mark FDR < alpha and the length, -log10 FDR (live.LENGTH, D-102);
     "passing" keeps every set that passes and, where fewer than top do, the failing sets of
     smallest p up to top in all; "top" the first top. */
  drawn: function (rows, how, alpha, top) {
    if (how !== "passing" && how !== "top") throw new Error("sets drawn: " + how);
    var held = rows.filter(function (r) { return r.hits > 0; }).sort(function (a, b) {
      return a.p - b.p || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
    }).map(function (r) { return { row: r, passes: r.fdr < alpha, length: -Math.log10(r.fdr) }; });
    if (how === "top") return held.slice(0, top);
    var passing = held.filter(function (d) { return d.passes; });
    if (passing.length >= top) return passing;
    return passing.concat(held.filter(function (d) { return !d.passes; })
      .slice(0, top - passing.length));
  },
  /* ctx.function.live.bars: families as [name, rows], each by drawn, the family whose first
     set has the smallest p first, a tie in the order given (sort is stable); a family with
     nothing drawn is left out. */
  blocks: function (families, how, alpha, top) {
    return families.map(function (f) { return [f[0], ctxOra.drawn(f[1], how, alpha, top)]; })
      .filter(function (f) { return f[1].length; })
      .sort(function (a, b) { return a[1][0].row.p - b[1][0].row.p; });
  },
  /* ctx.function.live.by_contrast: a contrast's own up and down calls and its own tested
     symbols, from the panel's data (live.panel). Its own state: the GSEA bars' contrast view
     does not move it. Null for a contrast the panel does not carry. */
  contrast: function (cfg, name) {
    var found = null, background = null;
    (cfg.contrasts || []).forEach(function (c) { if (c[0] === name) found = c; });
    cfg.backgrounds.forEach(function (b) { if (b[0] === name) background = b; });
    if (!found || !background) return null;
    var bits = Uint8Array.from(atob(background[2]), function (c) { return c.charCodeAt(0); });
    var tested = [];
    for (var i = 0; i < cfg.symbols.length; i++) if (bits[i >> 3] >> (i & 7) & 1) tested.push(cfg.symbols[i]);
    function names(list) { return list.map(function (i) { return cfg.symbols[i]; }); }
    return { up: names(found[2]), down: names(found[3]), background: tested };
  }
};
