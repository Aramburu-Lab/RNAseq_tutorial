{% raw %}
/* The page's call rule, apart from the page so tests/test_page_script.py runs it under node
   against ctx.de.stats.classify. A gene is called when it was tested (it has a value in
   cfg.gate) and the chosen p-value is below the cutoff; up at log2 FC >= t, down at <= -t. */
var ctxCalls = {
  /* The threshold in log2 from what the reader typed: a percent is 1 + v/100 times as high. */
  threshold: function (value, unit) {
    var v = Math.max(0, Number(value) || 0);
    return unit === "pct" ? Math.log2(1 + v / 100) : v;
  },
  /* The threshold as the box shows it in a unit: two decimals of log2, one of a percent. */
  display: function (t, unit) {
    return unit === "pct" ? (100 * (Math.pow(2, t) - 1)).toFixed(1) : t.toFixed(2);
  },
  /* The threshold in force. After a unit switch the box shows a rounded number, but the exact
     one stays in force until the reader types something else; state.unit is the unit the box's
     number was applied in, read on every call because a browser restoring the form on
     back-navigation sets the unit without a change event. */
  applied: function (state, typed, unit) {
    if (state.exact !== null && typed === state.shown) return state.exact;
    state.exact = null; state.unit = unit;
    return ctxCalls.threshold(typed, unit);
  },
  /* A unit switch: the threshold in force, shown in the new unit; returns what the box shows. */
  switchUnit: function (state, typed, unit) {
    var t = state.exact !== null && typed === state.shown
      ? state.exact : ctxCalls.threshold(typed, state.unit);
    state.exact = t; state.unit = unit; state.shown = ctxCalls.display(t, unit);
    return state.shown;
  },
  /* Whether the rule in force differs from the default one: a threshold, a basis or a cutoff
     moved. A unit switch alone shows the same rule in other words, so it is no move. */
  moved: function (cfg, t, basis, alpha) {
    return Math.abs(t - cfg.lfc_min) > 1e-12 || basis !== cfg.gate || alpha !== cfg.alpha;
  },
  /* The cutoff actually applied: the default for an empty box, else clamped to the range the
     box states, so the box and the rule never disagree. */
  cutoff: function (value, cfg) {
    var v = parseFloat(String(value).replace(",", "."));
    if (!isFinite(v)) return cfg.alpha;
    return Math.min(cfg.max_cutoff, Math.max(cfg.min_cutoff, v));
  },
  /* One rung stricter (dir < 0) or looser (dir > 0) on the ladder of the presets and the two
     bounds. A typed value between rungs goes to the next rung; at either end it stays. */
  step: function (value, dir, cfg) {
    var v = ctxCalls.cutoff(value, cfg);
    var rungs = cfg.presets.map(Number).concat([cfg.min_cutoff, cfg.max_cutoff])
      .sort(function (a, b) { return a - b; });
    var next = dir < 0
      ? rungs.filter(function (r) { return r < v; }).pop()
      : rungs.filter(function (r) { return r > v; })[0];
    return next === undefined ? v : next;
  },
  /* The raw p the cutoff sits at, as ctx.de.stats.p_line defines it: the bar the weakest
     passing gene cleared, so it moves with every cutoff. passing counts the tested genes
     whose chosen p is below alpha; cfg.n_tested counts every tested gene, drawn or not. */
  line: function (basis, alpha, cfg, passing) {
    var m = cfg.n_tested, rank = Math.max(passing, 1), harmonic = 0, i;
    if (m === 0) return null;
    if (basis === cfg.p) return alpha;
    if (basis === "padj") return rank * alpha / m;
    if (basis === "padj_by") {
      for (i = 1; i <= m; i++) harmonic += 1.0 / i;
      return rank * alpha / (m * harmonic);
    }
    if (basis === "padj_holm") return alpha / (m - rank + 1);
    if (basis === "padj_bonferroni") return alpha / m;
    throw new Error("unknown basis " + basis);
  },
  call: function (rows, cfg, t, column, alpha) {
    var parts = { up: [], down: [], ns: [] }, passing = 0;
    rows.forEach(function (r) {
      var tested = r[cfg.gate] !== null && r[cfg.gate] !== undefined;
      var q = r[column], level = "ns";
      var called = tested && q !== null && q !== undefined && q < alpha;
      if (called && r[cfg.lfc] >= t) level = "up";
      else if (called && r[cfg.lfc] <= -t) level = "down";
      if (called) passing += 1;
      parts[level].push(r);
    });
    return { parts: parts, line: ctxCalls.line(column, alpha, cfg, passing) };
  },
  /* How long typing must pause before the plot redraws, in ms. One redraw of 24,375 points
     took 897 to 933 ms headless (D-081), and a redraw per key held a burst for seconds. */
  QUIET_MS: 300,
  /* fn once, ms after the last of a burst of calls; cancel() drops a run not yet made.
     timers is {set, clear}: the page's setTimeout and clearTimeout, or a test's clock. */
  debounce: function (fn, ms, timers) {
    var t = timers || { set: function (f, d) { return setTimeout(f, d); },
                        clear: function (h) { clearTimeout(h); } };
    var pending = null;
    function later() {
      if (pending !== null) t.clear(pending);
      pending = t.set(function () { pending = null; fn(); }, ms);
    }
    later.cancel = function () {
      if (pending !== null) t.clear(pending);
      pending = null;
    };
    return later;
  }
};
{% endraw %}
