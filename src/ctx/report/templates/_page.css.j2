/* Every length and colour is a token from ctx.viz.style; only the two breakpoints are injected,
   because a media query cannot read a custom property. */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--background);color:var(--text);font:var(--size-base)/1.6 var(--font);font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
.page{max-width:calc(var(--content) + 2 * var(--gutter));margin:0 auto;padding:0 var(--gutter) var(--space-9)}
.content{min-width:0}
section,.group,.fig{scroll-margin-top:var(--space-8)}

/* Masthead */
.masthead{border-top:var(--rule-strong) solid var(--ink);padding-top:var(--space-5);margin-bottom:var(--space-7)}
.masthead-top{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4)}
.kicker{margin:0;font-size:var(--fs-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--link)}
h1{margin:var(--space-4) 0 var(--space-2);font-size:clamp(var(--fs-xl),5vw,var(--fs-display));line-height:1.05;letter-spacing:-.02em;font-weight:700;color:var(--ink)}
.deck{margin:0;font-size:var(--fs-sm);color:var(--muted)}
.deck strong{color:var(--ink);font-weight:700}
#ctx-theme-toggle{display:inline-flex;gap:var(--space-1);align-items:center;font:inherit;font-size:var(--fs-xs);letter-spacing:.06em;text-transform:uppercase;background:none;color:var(--muted);border:var(--rule) solid var(--reference);border-radius:999em;padding:var(--space-1) var(--space-3);cursor:pointer}
#ctx-theme-toggle:hover{border-color:var(--ink)}
:root[data-theme="white"] .t-light,:root[data-theme="black"] .t-dark{color:var(--ink);font-weight:700}
html:not(.js) #ctx-theme-toggle{display:none}

/* Sections: a numbered, ruled heading each */
.content{counter-reset:section}
section>h2{counter-increment:section;display:flex;align-items:baseline;gap:var(--space-3);margin:var(--space-8) 0 var(--space-4);padding-top:var(--space-4);border-top:var(--rule) solid var(--grid);font-size:var(--fs-lg);line-height:1.3;color:var(--ink)}
section>h2::before{content:counter(section,decimal-leading-zero);font-size:var(--fs-xs);font-weight:700;letter-spacing:.08em;color:var(--link)}
h3,h4{color:var(--ink);line-height:1.35}
/* Gene-set and contrast names can be one long word with underscores. */
h1,h2,h3,h4,.fig-title,.toc a,.key-value,.question{overflow-wrap:anywhere}
a{color:var(--link);text-decoration:underline;text-decoration-thickness:var(--rule);text-underline-offset:.2em}
a:hover{text-decoration-thickness:var(--rule-mid)}
:focus-visible{outline:var(--rule-mid) solid var(--ink);outline-offset:var(--rule-mid)}
code,pre{font-family:var(--font-mono);font-size:.92em}
summary{cursor:pointer;color:var(--link)}
button{font:inherit}
strong{color:var(--ink)}

/* Question, idea, terms */
.question{margin:0;font-size:var(--fs-lg);line-height:1.45;color:var(--ink)}
.idea{font-size:var(--fs-md);line-height:1.6}
details.terms{margin-top:var(--space-4);font-size:var(--fs-sm)}
details.terms dl{display:grid;grid-template-columns:max-content 1fr;gap:var(--space-2) var(--space-5);margin:var(--space-3) 0 0}
details.terms dt{font-weight:700;color:var(--ink)}
details.terms dd{margin:0;color:var(--text)}

/* Key numbers */
.keys{display:grid;grid-template-columns:repeat(auto-fit,minmax(var(--key-min),1fr));gap:var(--space-5);margin:0 0 var(--space-6);padding:var(--space-5) 0;border-top:var(--rule-mid) solid var(--ink);border-bottom:var(--rule) solid var(--grid)}
.keys div{min-width:0}
.keys dt{font-size:var(--fs-xs);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.keys dd{margin:0}
.key-value{font-size:var(--fs-xl);line-height:1.15;font-weight:700;color:var(--ink);letter-spacing:-.01em}
.key-detail{font-size:var(--fs-xs);color:var(--muted)}

/* Tables */
table{border-collapse:collapse;width:100%;font-size:var(--fs-sm)}
th,td{padding:var(--space-2) var(--space-3) var(--space-2) 0;border-bottom:var(--rule) solid var(--grid);text-align:left;vertical-align:top}
thead th{font-size:var(--fs-xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:var(--rule) solid var(--ink)}
.num{text-align:right}
.table-scroll{overflow-x:auto;margin:var(--space-5) 0}
.result-table caption{caption-side:top;text-align:left;font-weight:700;color:var(--ink);padding-bottom:var(--space-2);font-size:var(--fs-md)}
.sw{display:inline-block;width:var(--space-3);height:var(--space-3);margin-right:var(--space-2);vertical-align:middle;background:var(--sw);border-radius:var(--radius)}
.note{font-size:var(--fs-sm);color:var(--muted)}

/* Parameter cards */
.cards th[scope="row"],.cards td.default-cell{width:1%;white-space:nowrap}
.cards th[scope="row"] code{font-weight:700;color:var(--ink)}
code.default{padding:0 var(--space-2);border-radius:var(--radius);background:var(--surface);color:var(--ink)}
details.effect{margin-top:var(--space-1);font-size:var(--fs-xs)}
details.effect p{margin:var(--space-1) 0 0;color:var(--muted);font-size:var(--fs-sm)}

/* Groups and tabs */
.group>h3{margin:var(--space-8) 0 var(--space-1);font-size:var(--fs-lg)}
.group-lead{margin:0 0 var(--space-3);color:var(--muted)}
.tabs{display:flex;gap:var(--space-5);margin:var(--space-4) 0 0;border-bottom:var(--rule) solid var(--grid);overflow-x:auto;scrollbar-width:none}
.tabs [role="tab"]{border:0;border-bottom:var(--rule-mid) solid transparent;background:none;padding:var(--space-2) 0;font-size:var(--fs-sm);color:var(--muted);cursor:pointer;white-space:nowrap}
.tabs [role="tab"][aria-selected="true"]{color:var(--ink);font-weight:700;border-bottom-color:var(--ink)}
html:not(.js) .tabs{display:none}
.js .fig[hidden]{display:none}

/* Figure card */
.fig{margin:var(--space-6) 0 var(--space-8)}
.fig-num{margin:0;font-size:var(--fs-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--link)}
.fig-title{margin:var(--space-1) 0 0;font-size:var(--fs-md)}
.fig-lead{margin:var(--space-1) 0 0;color:var(--text)}
.fig-body{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);margin-top:var(--space-4);padding-top:var(--space-3);border-top:var(--rule) solid var(--grid)}
.fig-plot{min-width:0}
.reading{align-self:start;margin:0;padding:var(--space-4);background:var(--surface);border-left:var(--rule-strong) solid var(--ink);border-radius:0 var(--radius) var(--radius) 0;font-size:var(--fs-sm)}
.reading-title{margin:0 0 var(--space-2);font-size:var(--fs-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink)}
.reading ul{margin:0;padding-left:var(--space-4)}
.reading li{margin:var(--space-1) 0;color:var(--text)}
.fig figcaption{margin-top:var(--space-3);font-size:var(--fs-sm);line-height:1.55;color:var(--muted)}
.fig-files{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-4);margin:var(--space-2) 0 0;font-size:var(--fs-xs);color:var(--muted)}
.only-black{display:none}
:root[data-theme="black"] .only-black{display:inline}
:root[data-theme="black"] .only-white{display:none}

/* Live calling controls */
.calls{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-3) var(--space-5);margin:var(--space-4) 0 0;padding:var(--space-3) var(--space-4);border:var(--rule) solid var(--grid);border-radius:var(--radius)}
html:not(.js) .calls{display:none}
.calls label{display:flex;flex-direction:column;gap:var(--space-1);font-size:var(--fs-xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.calls .pair{display:flex;gap:var(--space-2)}
.calls input,.calls select{font:inherit;font-size:var(--fs-sm);letter-spacing:0;text-transform:none;font-weight:400;color:var(--ink);background:var(--background);border:var(--rule) solid var(--reference);border-radius:var(--radius);padding:var(--space-1) var(--space-2);min-height:calc(var(--space-6) + var(--space-2))}
.calls input{width:11ch}
.calls input:focus,.calls select:focus{border-color:var(--ink)}
.calls button{font-size:var(--fs-sm);color:var(--ink);background:none;border:var(--rule) solid var(--reference);border-radius:var(--radius);padding:var(--space-1) var(--space-3);min-height:calc(var(--space-6) + var(--space-2));cursor:pointer}
.calls button:hover{border-color:var(--ink)}
.calls .pair button{padding:var(--space-1) var(--space-2)}
.calls-summary{margin:var(--space-3) 0 0;font-size:var(--fs-md);color:var(--ink)}
.calls-summary .up,.calls-summary .down{font-weight:700}

/* In practice, self-checks, mistakes */
.practice{margin:0;padding:var(--space-4) var(--space-5);background:var(--surface);border-left:var(--rule-strong) solid var(--ink);border-radius:0 var(--radius) var(--radius) 0;font-size:var(--fs-md);color:var(--ink)}
ol.think{list-style:none;counter-reset:q;padding:0;margin:0}
ol.think>li{counter-increment:q;position:relative;margin:var(--space-5) 0;padding-left:var(--space-7)}
ol.think>li::before{content:counter(q);position:absolute;left:0;top:0;font-size:var(--fs-xl);font-weight:700;line-height:1;color:var(--muted)}
.prompt{margin:0;font-size:var(--fs-md);color:var(--ink)}
ol.think summary{margin-top:var(--space-2);font-size:var(--fs-xs);font-weight:700;letter-spacing:.08em;text-transform:uppercase}
ol.think details>p{margin:var(--space-2) 0 0;padding:var(--space-3) var(--space-4);background:var(--surface);border-radius:var(--radius)}
ul.mistakes{list-style:none;padding:0;margin:0}
ul.mistakes li{padding:var(--space-3) 0;border-bottom:var(--rule) solid var(--grid)}

/* Reproduce */
.command{position:relative;margin:0 0 var(--space-5)}
.command pre{margin:0;padding:var(--space-4) var(--space-9) var(--space-4) var(--space-4);background:var(--surface);border-radius:var(--radius);white-space:pre-wrap;overflow-wrap:anywhere;color:var(--ink)}
.copy{position:absolute;top:var(--space-2);right:var(--space-2);font-size:var(--fs-xs);color:var(--ink);background:var(--background);border:var(--rule) solid var(--reference);border-radius:var(--radius);padding:var(--space-1) var(--space-3);cursor:pointer}
.copy:hover{border-color:var(--ink)}
html:not(.js) .copy{display:none}
table.measured th{width:16em;font-weight:400;color:var(--muted)}
/* Byte counts are one long word; at phone width they must wrap, not push the page wider. */
table.measured td{overflow-wrap:anywhere}
.key-packages{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-4);margin:var(--space-4) 0 var(--space-2);font-size:var(--fs-sm);color:var(--muted)}
.key-packages span strong{font-weight:400}
details.versions{font-size:var(--fs-sm)}
details.versions dl{columns:3 14em;column-gap:var(--space-6);margin:var(--space-3) 0 0;font-size:var(--fs-xs)}
details.versions div{display:flex;justify-content:space-between;gap:var(--space-3);break-inside:avoid;border-bottom:var(--rule) solid var(--grid);padding:var(--space-1) 0}
details.versions dt{color:var(--text)}
details.versions dd{margin:0;color:var(--muted)}

/* Contents rail */
.toc{font-size:var(--fs-sm)}
.toc ol{list-style:none;margin:0;padding:0}
.toc a{display:block;padding:var(--space-1) 0 var(--space-1) var(--space-3);border-left:var(--rule-mid) solid var(--grid);color:var(--muted);text-decoration:none}
.toc a:hover{color:var(--ink)}
.toc a[aria-current]{color:var(--ink);font-weight:700;border-left-color:var(--ink)}
.toc .sub a{padding-left:var(--space-5);font-size:var(--fs-xs)}
.toc-title{margin:0 0 var(--space-3);font-size:var(--fs-xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

/* Hub */
.lede{margin:0 0 var(--space-6);font-size:var(--fs-lg);line-height:1.45;color:var(--ink)}
ol.modules{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--card-min),1fr));gap:var(--space-4);list-style:none;margin:0 0 var(--space-4);padding:0}
ol.modules li{display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-4);border:var(--rule) solid var(--grid);border-top:var(--rule-strong) solid var(--ink);border-radius:var(--radius)}
.module-name{font-size:var(--fs-md);font-weight:700}
.module-date,.missing{font-size:var(--fs-xs);color:var(--muted)}
.hub-section>h2{margin:var(--space-8) 0 var(--space-4);padding-top:var(--space-4);border-top:var(--rule) solid var(--grid);font-size:var(--fs-lg);color:var(--ink)}
.rules th[scope="row"]{white-space:nowrap;color:var(--ink)}
.rules ul{list-style:none;margin:var(--space-1) 0 0;padding:0;font-size:var(--fs-xs);color:var(--muted)}
.rules li{margin:var(--space-1) 0}
.rules code{font-size:.95em}
.pill{display:inline-block;padding:0 var(--space-2);line-height:1.9;border-radius:var(--radius);font-size:var(--fs-xs);font-weight:700;letter-spacing:.08em;color:var(--recorded-fg);background:var(--recorded-bg)}
.pill[data-verdict="PASS"]{color:var(--pass-fg);background:var(--pass-bg)}
.pill[data-verdict="FAIL"]{color:var(--fail-fg);background:var(--fail-bg)}
details.params{margin-top:var(--space-6)}

/* Narrow and wide screens */
@media (max-width:{{ layout.rail_from - 1 }}px){
.toc{position:sticky;top:0;z-index:2;margin:0 calc(-1 * var(--gutter)) var(--space-5);padding:0 var(--gutter);background:var(--background);border-bottom:var(--rule) solid var(--grid);overflow-x:auto;white-space:nowrap;scrollbar-width:none}
.toc>ol{display:flex;gap:var(--space-4)}
.toc a{padding:var(--space-3) 0;border-left:0;border-bottom:var(--rule-mid) solid transparent}
.toc a[aria-current]{border-bottom-color:var(--ink)}
.toc .sub,.toc-title{display:none}
}
@media (min-width:{{ layout.rail_from }}px){
.page.has-rail{display:grid;grid-template-columns:var(--rail) minmax(0,1fr);column-gap:var(--gap);max-width:calc(var(--rail) + var(--gap) + var(--content) + 2 * var(--gutter-wide));padding:0 var(--gutter-wide) var(--space-9)}
.toc{position:sticky;top:0;align-self:start;max-height:100vh;overflow-y:auto;padding-top:var(--space-7)}
.fig-body.has-reading{grid-template-columns:minmax(0,1fr) minmax(0,var(--reading))}
}
@media (max-width:{{ layout.narrow }}px){
.page{padding-left:var(--gutter);padding-right:var(--gutter)}
details.terms dl{grid-template-columns:1fr}
ol.think>li{padding-left:var(--space-6)}
table.measured th{width:auto}
.cards th[scope="row"],.cards td.default-cell{white-space:normal}
}
@media print{
:root,:root[data-theme="black"]{ {{ css.white }} color-scheme:light }
.toc,#ctx-theme-toggle,.copy,.fig-files,.tabs,.calls{display:none}
.js .fig[hidden]{display:block}
.page.has-rail{display:block;max-width:none;padding:0}
.fig,.keys,tr,.reading{break-inside:avoid}
}
