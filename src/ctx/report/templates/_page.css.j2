/* Every length and colour is a token from ctx.viz.style; only the breakpoints are injected,
   because a media query cannot read a custom property. The design is the ALI report's (D-024):
   a near-white page, white cards with a soft shadow, an inset grey, hairlines, a frosted bar. */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--page);color:var(--text);font:var(--size-base)/1.62 var(--font-page);font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
.page{max-width:calc(var(--content) + 2 * var(--gutter-wide));margin:0 auto;padding:0 var(--gutter-wide) var(--space-9)}
.content{min-width:0}
section,.group,.fig,.entry{scroll-margin-top:calc(var(--topbar) + var(--space-4))}

/* Skip link and top bar */
.skip{position:absolute;left:var(--space-4);top:calc(-1 * var(--topbar));z-index:60;padding:var(--space-2) var(--space-4);background:var(--surface);color:var(--link);border:var(--rule) solid var(--line-strong);border-radius:var(--radius-sm)}
.skip:focus{top:var(--space-2)}
.topbar{position:sticky;top:0;z-index:50;min-height:var(--topbar);display:flex;align-items:center;background:color-mix(in srgb,var(--page) 82%,transparent);backdrop-filter:saturate(1.4) blur(var(--topbar-blur));-webkit-backdrop-filter:saturate(1.4) blur(var(--topbar-blur));border-bottom:var(--rule) solid var(--line)}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);width:100%;padding:0 var(--gutter-wide)}
.brand{display:flex;align-items:center;gap:var(--space-3);margin:0;min-width:0;font-weight:700;letter-spacing:-.01em;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand small{font-size:var(--fs-xs);font-weight:500;color:var(--muted)}
.dot{flex:none;width:var(--dot);height:var(--dot);border-radius:50%;background:linear-gradient(90deg,var(--data-5),var(--data-3),var(--data-1))}
#ctx-theme-toggle{flex:none;display:inline-flex;gap:var(--space-1);align-items:center;font:inherit;font-size:var(--fs-xs);font-weight:600;background:var(--surface);color:var(--muted);border:var(--rule) solid var(--line-strong);border-radius:999em;padding:var(--space-1) var(--space-3);cursor:pointer}
#ctx-theme-toggle:hover{border-color:var(--link)}
:root[data-theme="white"] .t-light,:root[data-theme="black"] .t-dark{color:var(--text);font-weight:700}
html:not(.js) #ctx-theme-toggle{display:none}
.glossary-link{flex:none;margin-left:auto;font-size:var(--fs-xs);font-weight:600}

/* Glossary terms (D-048): a circled i at the phrase's top right, in the link colour, inside a
   target of --hit; the tooltip opens beside it, placed by the page script. The tooltip is
   fixed, so a scrolling card table cannot clip it: no ancestor of a term may set transform,
   filter, backdrop-filter, perspective, contain or will-change, which would trap it
   (tests/test_tooltip.py reads this file for them). */
.term{position:relative;padding-right:.9em;white-space:nowrap}
.term .info{position:absolute;top:calc(-.1em - var(--hit) / 2);right:calc(.25em - var(--hit) / 2);display:flex;align-items:center;justify-content:center;width:var(--hit);height:var(--hit);padding:0;border:0;border-radius:50%;background:none;color:var(--link);cursor:pointer}
.info-icon{width:.7em;height:.7em;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round}
html:not(.js) .term{padding-right:0}
html:not(.js) .term .info{display:none}
.tip{position:fixed;left:0;top:0;z-index:40;display:block;width:min(var(--tip),calc(100vw - 2 * var(--space-3)));padding:var(--space-3) var(--space-4);background:var(--surface);color:var(--text);border:var(--rule) solid var(--line-strong);border-radius:var(--radius-sm);box-shadow:var(--shadow);font-size:var(--fs-sm);font-weight:400;line-height:1.5;letter-spacing:0;text-transform:none;text-align:left;white-space:normal}
.tip[hidden]{display:none}
.tip-term{display:block;margin-bottom:var(--space-1);font-weight:700;color:var(--text)}
.tip-short{display:block}
.tip-link{display:inline-block;margin-top:var(--space-2)}

/* Hero */
.masthead{padding:var(--space-8) 0 var(--space-5)}
.kicker{margin:0;font-size:var(--fs-xs);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--link)}
h1{margin:var(--space-2) 0 var(--space-3);font-size:clamp(var(--fs-xl),4vw,var(--fs-display));line-height:1.08;letter-spacing:-.025em;font-weight:700;color:var(--text)}
.deck{margin:0;font-size:var(--fs-md);color:var(--muted)}
.deck strong{color:var(--text);font-weight:700}

/* Sections: a hairline and a monospace number each */
.content{counter-reset:section}
section>h2{counter-increment:section;display:flex;align-items:baseline;gap:var(--space-3);margin:0 0 var(--space-4);font-size:var(--fs-lg);line-height:1.25;letter-spacing:-.02em;color:var(--text)}
section>h2::before{content:counter(section,decimal-leading-zero);font-family:var(--font-mono);font-size:var(--fs-xs);font-weight:700;letter-spacing:0;color:var(--muted)}
.content>section{padding:var(--space-6) 0;border-top:var(--rule) solid var(--line)}
h3,h4{color:var(--text);line-height:1.35;letter-spacing:-.01em}
/* Gene-set and contrast names can be one long word with underscores. */
h1,h2,h3,h4,.fig-title,.toc a,.key-value,.question,.brand{overflow-wrap:anywhere}
a{color:var(--link);text-decoration:underline;text-decoration-thickness:var(--rule);text-underline-offset:.2em}
a:hover{text-decoration-thickness:var(--rule-mid)}
:focus-visible{outline:var(--rule-mid) solid var(--link);outline-offset:var(--rule-mid);border-radius:var(--radius-xs)}
code,pre{font-family:var(--font-mono);font-size:.88em}
summary{cursor:pointer;color:var(--link)}
button{font:inherit}
strong{color:var(--text)}

/* Question, idea, terms */
.question{margin:0;font-size:var(--fs-lg);line-height:1.45;letter-spacing:-.01em;color:var(--text)}
.idea{margin:0;font-size:var(--fs-md);line-height:1.62}
details.terms,details.versions,details.params{margin-top:var(--space-5);background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
details.terms>summary,details.versions>summary,details.params>summary{padding:var(--space-4) var(--space-5);font-size:var(--fs-sm);font-weight:700;list-style-position:inside}
details.terms dl{display:grid;grid-template-columns:max-content 1fr;gap:var(--space-2) var(--space-5);margin:0;padding:0 var(--space-5) var(--space-5);font-size:var(--fs-sm)}
details.terms dt{font-weight:700;color:var(--text)}
details.terms dd{margin:0;color:var(--text)}

/* Key numbers: stat tiles */
.keys{display:grid;grid-template-columns:repeat(auto-fit,minmax(var(--key-min),1fr));gap:var(--space-3);margin:0 0 var(--space-6);padding:0}
.keys div{display:flex;flex-direction:column;min-width:0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm)}
.keys dt{order:2;margin-top:var(--space-1);font-size:var(--fs-xs);color:var(--muted)}
.keys dd{margin:0}
.key-value{order:1;font-size:var(--fs-xl);line-height:1.1;font-weight:700;letter-spacing:-.02em;color:var(--text)}
.key-detail{order:3;font-size:var(--fs-xs);color:var(--muted)}

/* Tables, in a rounded wrap */
table{border-collapse:collapse;width:100%;font-size:var(--fs-sm)}
th,td{padding:var(--space-2) var(--space-3);border-bottom:var(--rule) solid var(--line);text-align:left;vertical-align:top}
thead th{background:var(--surface-2);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
tbody tr:last-child>*{border-bottom:0}
.num{text-align:right}
.table-scroll{overflow-x:auto;margin:var(--space-5) 0;background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.result-table caption{caption-side:top;text-align:left;font-weight:700;color:var(--text);padding:var(--space-3) var(--space-3) var(--space-2);font-size:var(--fs-md)}
.sw{display:inline-block;width:var(--space-3);height:var(--space-3);margin-right:var(--space-2);vertical-align:middle;background:var(--sw);border-radius:var(--radius-xs)}
.note{font-size:var(--fs-sm);color:var(--muted)}

/* Parameter cards */
.cards th[scope="row"],.cards td.default-cell{width:1%;white-space:nowrap}
.cards th[scope="row"] code{padding:0 var(--space-2);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-xs);font-weight:700;color:var(--text)}
code.default{padding:0 var(--space-2);border-radius:var(--radius-xs);background:var(--surface-2);color:var(--text)}
details.effect{margin-top:var(--space-1);font-size:var(--fs-xs)}
details.effect p{margin:var(--space-1) 0 0;color:var(--muted);font-size:var(--fs-sm)}
details.params .table-scroll{margin:0;border:0;border-top:var(--rule) solid var(--line);border-radius:0;box-shadow:none}

/* Groups and tabs */
.group>h3{margin:var(--space-7) 0 var(--space-1);font-size:var(--fs-md)}
.group-lead{margin:0 0 var(--space-3);color:var(--muted)}
/* Tabs wrap onto as many lines as the width needs: a scrolled row hid the tabs past its edge. */
.tabs{display:flex;flex-wrap:wrap;gap:var(--space-2);margin:var(--space-4) 0 0;padding:var(--space-1);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm)}
.tabs [role="tab"]{border:0;border-radius:var(--radius-xs);background:none;padding:var(--space-1) var(--space-3);font-size:var(--fs-sm);color:var(--muted);cursor:pointer;white-space:nowrap}
.tabs [role="tab"][aria-selected="true"]{background:var(--surface);color:var(--text);font-weight:700;box-shadow:var(--shadow)}
html:not(.js) .tabs{display:none}
.js .fig[hidden]{display:none}

/* Figure card */
.fig{margin:var(--space-5) 0 var(--space-6);padding:var(--fig-pad);background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.fig-num{margin:0;font-size:var(--fs-xs);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--link)}
.fig-title{margin:var(--space-1) 0 0;font-size:var(--fs-md)}
.fig-lead{margin:var(--space-1) 0 0;color:var(--text)}
.fig-body{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--fig-gap);margin-top:var(--space-4)}
/* A plot kept from shrinking below its least legible width, on a phone or opened alone at
   twice its type, scrolls inside the card, and the page script shows the hint above it. */
.fig-plot{min-width:0;overflow-x:auto}
/* A second plot under the plot and its reading guide, across the card: a linked view's parallel sets. */
.fig-below{min-width:0;margin-top:var(--fig-gap);overflow-x:auto}
.scroll-hint{position:sticky;left:0;margin:0 0 var(--space-2);font-size:var(--fs-sm);color:var(--muted)}
/* Opened alone, a figure's type, marks and lines are twice the page's (style.ALONE_SCALE) and
   its plot twice as wide where the window has room (figures.figure_html): the page takes the
   window's width and the reading guide goes under the plot. */
.page.alone{max-width:none}
.reading{align-self:start;margin:0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-left:var(--rule-accent) solid var(--link);border-radius:var(--radius-sm);font-size:var(--fs-sm)}
.reading-title{margin:0 0 var(--space-2);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--link)}
.reading ul{margin:0;padding-left:var(--space-4)}
.reading li{margin:var(--space-1) 0;color:var(--text)}
.fig figcaption{margin-top:var(--space-3);font-size:var(--fs-xs);line-height:1.55;color:var(--muted)}
.fig-files{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-4);margin:var(--space-2) 0 0;font-size:var(--fs-xs);color:var(--muted)}
/* A moved view's PDF and SVG draw in the page and link no file. */
.fig-files a[role=button]{cursor:pointer}
.only-black{display:none}
:root[data-theme="black"] .only-black{display:inline}
:root[data-theme="black"] .only-white{display:none}

/* Live calling controls */
.calls{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-3) var(--space-5);margin:var(--space-4) 0 0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm)}
html:not(.js) .calls{display:none}
.brush{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-3) var(--space-5);margin:var(--space-4) 0 0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm)}
html:not(.js) .brush{display:none}
.brush fieldset{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-3);margin:0;padding:0;border:0}
.brush legend{margin-bottom:var(--space-1);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.brush .paint{display:flex;align-items:center;gap:var(--space-1);font-size:var(--fs-sm);color:var(--text);cursor:pointer}
.brush button{font-size:var(--fs-sm);color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-1) var(--space-3);min-height:calc(var(--space-6) + var(--space-2));cursor:pointer}
.brush button:hover{border-color:var(--link)}
.brush-how{margin:0;font-size:var(--fs-xs);color:var(--muted)}
.calls label{display:flex;flex-direction:column;gap:var(--space-1);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.calls .pair{display:flex;gap:var(--space-2)}
.calls input,.calls select{font:inherit;font-size:var(--fs-sm);letter-spacing:0;text-transform:none;font-weight:400;color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-1) var(--space-2);min-height:calc(var(--space-6) + var(--space-2))}
.calls input{width:11ch}
.calls input:focus,.calls select:focus{border-color:var(--link)}
.calls button{font-size:var(--fs-sm);color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-1) var(--space-3);min-height:calc(var(--space-6) + var(--space-2));cursor:pointer}
.calls button:hover{border-color:var(--link)}
.calls .pair button{padding:var(--space-1) var(--space-2)}
.calls-summary{margin:var(--space-3) 0 0;font-size:var(--fs-md);color:var(--text)}
.survival{display:flex;flex-wrap:wrap;align-items:flex-end;gap:var(--space-3) var(--space-5);margin:var(--space-4) 0 0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm)}
html:not(.js) .survival{display:none}
.survival label{display:flex;flex-direction:column;gap:var(--space-1);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.survival .genes{flex:1 1 16rem;min-width:0}
.survival .hint{font-weight:400;letter-spacing:0;text-transform:none}
.survival select,.survival textarea{font:inherit;font-size:var(--fs-sm);letter-spacing:0;text-transform:none;font-weight:400;color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-1) var(--space-2);min-height:calc(var(--space-6) + var(--space-2))}
.survival textarea{width:100%;box-sizing:border-box;resize:vertical}
.survival select:focus,.survival textarea:focus{border-color:var(--link)}
.survival button{font-size:var(--fs-sm);color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-1) var(--space-3);min-height:calc(var(--space-6) + var(--space-2));cursor:pointer}
.survival button:hover{border-color:var(--link)}
.survival button:disabled{cursor:default;opacity:.6}
.survival-summary{margin:var(--space-3) 0 0;font-size:var(--fs-md);color:var(--text)}
.survival-notes{margin:var(--space-2) 0 0;font-size:var(--fs-sm);color:var(--muted)}
.calls-summary .up,.calls-summary .down{font-weight:700}

/* In practice (a good callout), self-checks, mistakes (a warn callout) */
.practice{margin:0;padding:var(--space-4) var(--space-5);background:color-mix(in srgb,var(--good-fill) var(--tint-fill),transparent);border:var(--rule) solid color-mix(in srgb,var(--good-fill) var(--tint-border),var(--line));border-radius:var(--radius-sm);font-size:var(--fs-md);color:var(--text)}
ol.think{list-style:none;counter-reset:q;padding:0;margin:0;display:grid;gap:var(--space-3)}
ol.think>li{counter-increment:q;position:relative;margin:0;padding:var(--space-4) var(--space-5) var(--space-4) var(--space-8);background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
ol.think>li::before{content:counter(q,decimal-leading-zero);position:absolute;left:var(--space-5);top:var(--space-4);font-family:var(--font-mono);font-size:var(--fs-xs);font-weight:700;line-height:2;color:var(--muted)}
.prompt{margin:0;font-size:var(--fs-md);color:var(--text)}
ol.think summary{margin-top:var(--space-2);font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase}
ol.think details>p{margin:var(--space-2) 0 0;padding:var(--space-3) var(--space-4);background:var(--surface-2);border-radius:var(--radius-sm)}
ul.mistakes{list-style:none;margin:0;padding:var(--space-2) var(--space-5);background:color-mix(in srgb,var(--warn-fill) var(--tint-fill),transparent);border:var(--rule) solid color-mix(in srgb,var(--warn-fill) var(--tint-border),var(--line));border-radius:var(--radius-sm)}
ul.mistakes li{padding:var(--space-3) 0;border-bottom:var(--rule) solid color-mix(in srgb,var(--warn-fill) var(--tint-border),var(--line))}
ul.mistakes li:last-child{border-bottom:0}
ul.mistakes strong{color:var(--warn)}
.zipped{margin:0 0 var(--space-5);padding:var(--space-4) var(--space-5);background:color-mix(in srgb,var(--warn-fill) var(--tint-fill),transparent);border:var(--rule) solid color-mix(in srgb,var(--warn-fill) var(--tint-border),var(--line));border-radius:var(--radius-sm)}
.zipped strong{color:var(--warn)}

/* Reproduce */
.command{position:relative;margin:0 0 var(--space-5)}
.code{margin:0 0 var(--space-5)}
.code figcaption{font-weight:600;margin:0 0 var(--space-2)}
.code .command{margin:0}
.sha{font-size:var(--fs-sm);color:var(--muted);overflow-wrap:anywhere;margin:var(--space-2) 0 0}
.command pre{margin:0;padding:var(--space-4) var(--space-9) var(--space-4) var(--space-4);background:var(--surface-2);border:var(--rule) solid var(--line);border-radius:var(--radius-sm);white-space:pre-wrap;overflow-wrap:anywhere;color:var(--text)}
.copy{position:absolute;top:var(--space-2);right:var(--space-2);font-size:var(--fs-xs);font-weight:600;color:var(--text);background:var(--surface);border:var(--rule) solid var(--line-strong);border-radius:999em;padding:var(--space-1) var(--space-3);cursor:pointer}
.copy:hover{border-color:var(--link)}
html:not(.js) .copy{display:none}
table.measured th{width:16em;font-weight:400;color:var(--muted)}
/* Byte counts are one long word; at phone width they must wrap, not push the page wider. */
table.measured td{overflow-wrap:anywhere}
.key-packages{display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-4);margin:var(--space-4) 0 var(--space-2);font-size:var(--fs-sm);color:var(--muted)}
.key-packages span strong{font-weight:400}
details.versions dl{columns:3 14em;column-gap:var(--space-6);margin:0;padding:0 var(--space-5) var(--space-5);font-size:var(--fs-xs)}
details.versions div{display:flex;justify-content:space-between;gap:var(--space-3);break-inside:avoid;border-bottom:var(--rule) solid var(--line);padding:var(--space-1) 0}
details.versions dt{color:var(--text)}
details.versions dd{margin:0;color:var(--muted)}

/* Contents rail */
.toc{font-size:var(--fs-sm)}
.toc ol{list-style:none;margin:0;padding:0}
.toc a{display:block;padding:var(--space-1) 0 var(--space-1) var(--space-3);border-left:var(--rule-mid) solid var(--line);color:var(--muted);text-decoration:none}
.toc a:hover{color:var(--text)}
.toc a[aria-current]{color:var(--text);font-weight:700;border-left-color:var(--link)}
.toc .sub a{padding-left:var(--space-5);font-size:var(--fs-xs)}
.toc-title{margin:0 0 var(--space-3);font-size:var(--fs-xs);font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

/* Hub */
.lede{margin:0 0 var(--space-6);font-size:var(--fs-lg);line-height:1.45;color:var(--muted)}
ol.modules{display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--card-min),1fr));gap:var(--space-4);list-style:none;margin:0 0 var(--space-4);padding:0}
ol.modules>li{display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-4) var(--space-5);background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.module-name{font-size:var(--fs-md);font-weight:700}
.module-date,.missing{font-size:var(--fs-xs);color:var(--muted)}
.hub-section{padding:var(--space-6) 0;border-top:var(--rule) solid var(--line)}
.hub-section>h2{margin:0 0 var(--space-4);font-size:var(--fs-lg);letter-spacing:-.02em;color:var(--text)}
.rules th[scope="row"]{white-space:nowrap;color:var(--text)}
.rules ul{list-style:none;margin:var(--space-1) 0 0;padding:0;font-size:var(--fs-xs);color:var(--muted)}
.rules li{margin:var(--space-1) 0}
.rules code{font-size:.95em}
.pill{display:inline-block;padding:0 var(--space-2);line-height:1.9;border-radius:var(--radius-xs);font-size:var(--fs-xs);font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--recorded-fg);background:var(--recorded-bg)}
.pill[data-verdict="PASS"]{color:var(--pass-fg);background:var(--pass-bg)}
.pill[data-verdict="FAIL"]{color:var(--fail-fg);background:var(--fail-bg)}
.pill[data-kind="real"]{color:var(--pass-fg);background:var(--pass-bg)}
.pill[data-kind="made-up"]{color:var(--made-fg);background:var(--made-bg)}
.course-links{display:flex;flex-direction:column;gap:var(--space-1);list-style:none;margin:0;padding:0}
.course-links li{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2)}

/* Glossary page */
.glossary-search{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2) var(--space-4);margin:0 0 var(--space-5)}
.glossary-search label{font-size:var(--fs-xs);font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.glossary-search input{flex:1 1 16em;min-width:0;font:inherit;font-size:var(--fs-sm);color:var(--text);background:var(--surface);border:var(--rule) solid var(--reference);border-radius:var(--radius-xs);padding:var(--space-2) var(--space-3)}
.glossary-search input:focus{border-color:var(--link)}
.glossary-count{margin:0;font-size:var(--fs-xs);color:var(--muted)}
html:not(.js) .glossary-search{display:none}
.entry{margin:var(--space-4) 0;padding:var(--space-4) var(--space-5);background:var(--surface);border:var(--rule) solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.entry:target{border-color:var(--link)}
.entry h3{margin:0;font-size:var(--fs-md)}
.entry p{margin:var(--space-2) 0 0}
.entry .short{color:var(--text);font-weight:600}
.aliases,.see-also,.entry .source{font-size:var(--fs-sm);color:var(--muted)}
.entry[hidden],.glossary-group[hidden]{display:none}
.pill[data-kind="unverified"]{color:var(--made-fg);background:var(--made-bg)}

/* Narrow and wide screens */
@media (max-width:{{ layout.rail_from - 1 }}px){
/* One row, its scrollbar shown: a hidden one hid the sections past the edge. */
.toc{position:sticky;top:var(--topbar);z-index:2;margin:0 calc(-1 * var(--gutter-wide)) var(--space-5);padding:0 var(--gutter-wide);background:color-mix(in srgb,var(--page) 92%,transparent);backdrop-filter:blur(var(--topbar-blur));-webkit-backdrop-filter:blur(var(--topbar-blur));border-bottom:var(--rule) solid var(--line);overflow-x:auto;white-space:nowrap;scrollbar-width:thin}
.toc>ol{display:flex;gap:var(--space-4)}
.toc a{padding:var(--space-3) 0;border-left:0;border-bottom:var(--rule-mid) solid transparent}
.toc a[aria-current]{border-bottom-color:var(--link)}
.toc .sub,.toc-title{display:none}
section,.group,.fig,.entry{scroll-margin-top:calc(2 * var(--topbar) + var(--space-4))}
}
@media (min-width:{{ layout.rail_from }}px){
.page.has-rail{display:grid;grid-template-columns:var(--rail) minmax(0,1fr);column-gap:var(--gap);max-width:calc(var(--rail) + var(--gap) + var(--content) + 2 * var(--gutter-wide))}
.toc{position:sticky;top:var(--topbar);align-self:start;max-height:calc(100vh - var(--topbar));overflow-y:auto;padding-top:var(--space-8)}
.page:not(.alone) .fig-body.has-reading{grid-template-columns:minmax(0,1fr) minmax(0,var(--reading))}
}
@media (max-width:{{ layout.narrow }}px){
.page{padding-left:var(--gutter);padding-right:var(--gutter)}
.topbar-inner{padding:0 var(--gutter)}
.toc{margin-left:calc(-1 * var(--gutter));margin-right:calc(-1 * var(--gutter));padding:0 var(--gutter)}
.fig{padding:var(--space-4) var(--space-3)}
details.terms dl{grid-template-columns:1fr}
ol.think>li{padding-left:var(--space-7)}
ol.think>li::before{left:var(--space-3)}
table.measured th{width:auto}
.cards th[scope="row"],.cards td.default-cell{white-space:normal}
}
@media print{
@page{size:A4 portrait;margin:12mm}
:root,:root[data-theme="black"]{ {{ css.white }} color-scheme:light }
.topbar,.skip,.toc,#ctx-theme-toggle,.copy,.fig-files,.tabs,.calls,.survival,.term .info,.tip,.glossary-search{display:none}
.term{padding-right:0}
.js .fig[hidden]{display:block}
.page.has-rail{display:block;max-width:none;padding:0}
.fig,.table-scroll,details{box-shadow:none}
.fig,.keys,tr,.reading,ol.think>li{break-inside:avoid}
}
