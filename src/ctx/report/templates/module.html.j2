{% extends "base.html.j2" %}
{% from "_figure.html.j2" import figure_block, panel_block, result_table with context %}
{% from "_cards.html.j2" import cards_table with context %}
{# A code block's text is printed as given: pre keeps every space and line end, and its Copy button names this block's own id. #}
{% macro code_block(it) %}<figure class="code"><figcaption>{{ it.code.title }}{% if it.code.source %} <code>{{ it.code.source }}</code>{% endif %}</figcaption><div class="command"><pre><code id="{{ it.id }}">{{ it.code.text }}</code></pre><button type="button" class="copy" data-copy="{{ it.id }}" data-copied="{{ ui.reproduce.copied }}" data-selected="{{ ui.reproduce.selected }}">{{ ui.reproduce.button }}</button></div><p class="sha">{{ ui.code.sha256 }} <code>{{ it.code.sha256 }}</code></p></figure>{% endmacro %}
{% macro item(kind, it, tab=false) %}{% if kind == "figure" %}{{ figure_block(it, tab=tab) }}{% elif kind == "table" %}{{ result_table(it) }}{% elif kind == "code" %}{{ code_block(it) }}{% elif kind == "panel" %}{{ panel_block(it) }}{% else %}<p class="note">{{ it }}</p>{% endif %}{% endmacro %}
{% block page_class %}{% if not lite %} has-rail{% endif %}{% endblock %}
{% block rail %}
{% if not lite %}
<nav class="toc" aria-label="{{ ui.contents.label }}"><p class="toc-title">{{ ui.contents.title }}</p><ol>
{% for id, title in sections %}<li><a href="#{{ id }}">{{ title }}</a>{% if id == "results" and outline %}<ol class="sub">{% for anchor, label in outline %}<li><a href="#{{ anchor }}">{{ label }}</a></li>{% endfor %}</ol>{% endif %}</li>
{% endfor %}</ol></nav>
{% endif %}
{% endblock %}
{% block content %}
{% for id, title in sections %}
<section id="{{ id }}">
<h2>{{ title }}</h2>
{% if id == "purpose" %}
<p class="question">{{ page.purpose | explain_terms(id) }}</p>
{% elif id == "input" %}
<p class="input">{{ page.input | explain_terms(id) }}</p>
{% elif id == "method" %}
<p class="idea">{{ page.method | explain_terms(id) }}</p>
{% if page.terms %}<details class="terms"><summary>{{ ui.page.terms }}</summary><dl>{% for term, meaning in page.terms %}<dt>{{ term }}</dt><dd>{{ meaning | code }}</dd>{% endfor %}</dl></details>{% endif %}
{% elif id == "parameters" %}
{{ cards_table(page.parameters) }}
{% elif id == "results" %}
{% if page.key_numbers and not lite %}<dl class="keys">{% for k in page.key_numbers %}<div><dt>{{ k.label }}</dt><dd class="key-value">{{ k.value }}</dd>{% if k.detail %}<dd class="key-detail">{{ k.detail }}</dd>{% endif %}</div>{% endfor %}</dl>{% endif %}
{% for kind, it in results %}
{% if kind == "group" %}
<div class="group" id="{{ it.anchor }}">
<h3>{{ it.group.title }}</h3>
{% if it.group.lead %}<p class="group-lead">{{ it.group.lead }}</p>{% endif %}
{% if it.group.tabs %}
<div class="tabs" role="tablist" aria-label="{{ it.group.title }}">{% for k2, f in it["items"] %}<button type="button" role="tab" id="tab-{{ f.number }}" aria-controls="figure-{{ f.number }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ f.tab }}</button>{% endfor %}</div>
{% endif %}
{% if it.group.packed %}
{# Drawn when the reader reaches it, from the gzipped HTML below (page script: packed). #}
{% set body %}{% for k2, sub in it["items"] %}{{ item(k2, sub, tab=it.group.tabs) }}{% endfor %}{% endset %}
<div class="packed-body" data-packed="ctx-packed-{{ loop.index }}" data-drawing="{{ ui.packed.drawing }}" data-failed="{{ ui.packed.failed }}"><p class="note packed-note" aria-live="polite">{{ ui.packed.waiting }}</p><button type="button" data-unpack>{{ ui.packed.draw }}</button></div>
<noscript><p class="note">{{ ui.packed.noscript }}</p></noscript>
<script type="application/octet-stream" id="ctx-packed-{{ loop.index }}">{{ body | pack }}</script>
{% else %}
{% for k2, sub in it["items"] %}{{ item(k2, sub, tab=it.group.tabs) }}{% endfor %}
{% endif %}
</div>
{% else %}
{{ item(kind, it) }}
{% endif %}
{% endfor %}
{% elif id == "interpretation" %}
<p class="practice">{{ page.interpretation | explain_terms(id) }}</p>
{% elif id == "questions" %}
<ol class="think">
{% for check in page.questions %}
<li><p class="prompt">{{ check.prompt | explain_terms(id) }}</p><details><summary>{{ ui.page.answer }}</summary><p>{{ check.answer | explain_terms(id) }}</p></details></li>
{% endfor %}
</ol>
{% elif id == "pitfalls" %}
<ul class="mistakes">
{% for m in page.pitfalls %}{% set head, colon, tail = m.partition(": ") %}<li>{% if colon %}<strong>{{ head | explain_terms(id) }}:</strong> {{ tail | explain_terms(id) }}{% else %}{{ m | explain_terms(id) }}{% endif %}</li>
{% endfor %}
</ul>
{% elif id == "reproduce" %}
{% set r = page.reproduce %}
<div class="command"><pre><code id="ctx-command">{{ r.command }}</code></pre><button type="button" class="copy" data-copy="ctx-command" data-copied="{{ ui.reproduce.copied }}" data-selected="{{ ui.reproduce.selected }}">{{ ui.reproduce.button }}</button></div>
<table class="measured">
<tr><th>{{ ui.reproduce.wall }}</th><td class="wall">{{ "%.3f"|format(r.wall_seconds) }} s</td></tr>
<tr><th>{{ ui.reproduce.rss_self }}</th><td class="rss-self">{{ "%.1f"|format(r.peak_rss_self / 1048576) }} MiB ({{ r.peak_rss_self }} bytes)</td></tr>
<tr><th>{{ ui.reproduce.rss_children }}</th><td class="rss-children">{{ "%.1f"|format(r.peak_rss_children / 1048576) }} MiB ({{ r.peak_rss_children }} bytes)</td></tr>
<tr><th>{{ ui.reproduce.profile }}</th><td>{{ r.profile }}</td></tr>
<tr><th>{{ ui.reproduce.budget }}</th><td>{{ r.budget }}</td></tr>
{% if r.inputs %}<tr><th>{{ ui.reproduce.inputs }}</th><td>{{ r.inputs|join(", ") }}</td></tr>{% endif %}
</table>
{% if key_versions %}<p class="key-packages">{% for name, version in key_versions %}<span>{{ name }} <strong>{{ version }}</strong></span>{% endfor %}</p>{% endif %}
<details class="versions"><summary>{{ ui.reproduce.versions.format(n=r.versions|length) }}</summary><dl>{% for name, version in r.versions.items() %}<div><dt>{{ name }}</dt><dd>{{ version }}</dd></div>{% endfor %}</dl></details>
{% endif %}
</section>
{% endfor %}
{% endblock %}
