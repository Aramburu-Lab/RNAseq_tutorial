{# M6's running score for any tested set (WO7). Included by _page.js.j2, inside its one function. #}
{% raw %}  /* ctxRunning draws the chosen set's running sum and its members along the ranking; the
     title, lead and caption are the set's own, looked up, as are NES, p and FDR. The ES the
     page draws is checked against the table's, and the live line says where they differ. The
     contrast select (V2) draws another contrast's ranking and lists its tested sets, keeping
     the set shown where that contrast tested it (ctxRunning.keep). */
  function runningSet(form) {
    var fig = form.closest(".fig");
    var cfg = JSON.parse(document.getElementById(form.getAttribute("data-controls")).textContent);
    var div = fig.querySelector(".js-plotly-plot"), mark = exporting(fig, cfg);
    var lead = fig.querySelector(".fig-lead"), caption = fig.querySelector("figcaption");
    var title = fig.querySelector(".fig-title"), summary = fig.querySelector(".running-summary");
    var built = cfg.export, picker = form.elements.contrast, sets = form.elements.set;
    var start = { lead: lead ? lead.innerHTML : "", caption: caption.innerHTML,
                  title: title ? title.textContent : "" };
    /* The build's contrast is the top level's ranking and sets; each other carries its own. */
    var contrasts = (cfg.contrasts && cfg.contrasts.length ? cfg.contrasts : [{}]).map(function (c, i) {
      return { label: c.label, sets: i ? c.sets : cfg.sets, encoded: i ? c.weights : cfg.weights };
    });
    var decoded = [];
    function weightsOf(c) {
      if (!decoded[c]) decoded[c] = ctxRunning.values(contrasts[c].encoded);
      return decoded[c];
    }
    function trace(name) {
      for (var i = 0; i < div.data.length; i++) if (div.data[i].name === name) return i;
      return -1;
    }
    var line = trace(cfg.line), dots = trace(cfg.member), shownContrast = 0;
    function fill(text, values) {
      return text.replace(/\{(\w+)\}/g, function (all, key) {
        return Object.prototype.hasOwnProperty.call(values, key) ? values[key] : all;
      });
    }
    /* Another contrast's sets in the set select, the set kept where that contrast tested it. */
    function relist(c) {
      var current = contrasts[shownContrast].sets[Number(sets.value)];
      var list = contrasts[c].sets, at = ctxRunning.keep(list.map(function (s) { return s.name; }),
                                                         current ? current.name : "", cfg.build_set);
      sets.innerHTML = "";
      list.forEach(function (s, i) {
        var o = document.createElement("option");
        o.value = String(i); o.textContent = s.label; sets.appendChild(o);
      });
      sets.value = String(at);
      shownContrast = c;
    }
    function show(e) {
      var c = picker ? Number(picker.value) : 0;
      if (c !== shownContrast || (e && e.target === picker)) relist(c);
      var i = Number(sets.value), s = contrasts[c].sets[i], weights = weightsOf(c);
      var run = ctxRunning.running(weights, s.positions), es = ctxRunning.score(run);
      var moved = c !== 0 || i !== 0;
      /* Every rank, x with y: the build's line may carry fewer points than the ranking. */
      Plotly.restyle(div, { x: [run.map(function (_, r) { return r; })], y: [run] }, [line]);
      Plotly.restyle(div, { x: [s.positions], y: [s.positions.map(function (p) { return run[p]; })],
                            customdata: [s.genes.map(function (g) { return [g]; })] }, [dots]);
      if (lead) lead.innerHTML = moved ? s.lead : start.lead;
      caption.innerHTML = moved ? s.caption : start.caption;
      if (title) title.textContent = moved ? s.title : start.title;
      var label = c ? contrasts[c].label + ": " + s.label : s.label;
      var build = c ? cfg.build_contrast + ": " + cfg.build : cfg.build;
      var words = moved ? fill(cfg.moved, { label: label, build: build }) : "";
      if (Math.abs(es - s.es) > cfg.tolerance) {
        words = (words + " " + fill(cfg.differs, { page: es.toFixed(4), table: s.es.toFixed(4) })).trim();
      }
      summary.textContent = words;
      if (built) cfg.export = moved ? Object.assign({}, built, { caption: s.export_caption }) : built;
      mark(moved, "running");
      /* What the page drew and its files would print, for a reader's script and the tests. */
      fig.ctxRunning = { es: es, set: s.label, contrast: c, caption: cfg.export ? cfg.export.caption : null };
    }
    form.addEventListener("change", show);
    form.addEventListener("submit", function (e) { e.preventDefault(); });
    /* A browser restoring the form on back-navigation sets the selects without an event. */
    if (picker && picker.value !== "0") { relist(Number(picker.value)); show(); }
    else if (sets.value !== "0") show();
  }

{% endraw %}
