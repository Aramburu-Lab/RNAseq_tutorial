{% raw %}
/* A figure's own PDF and SVG of a changed view (D-033, amended 2026-10-01): once the reader
   has moved its page controls from their defaults, the PDF and SVG buttons draw the view as
   set, at the size, type and white theme of the figure's own files; the PDF embeds Ctx Sans,
   the page's subset of Liberation Sans, Arial's metric twin. Everything but draw(), pdf() and
   save() runs under node in tests/test_page_script.py. The page script borrows wrap() and
   words() for its axis titles. */
var ctxExport = {
  /* Words greedily onto lines while fits(line) holds; a word is never split, as
     ctx.viz.metrics.wrap_to wraps a figure file's caption. Takes a text, or its words. */
  wrap: function (text, fits) {
    var lines = [];
    var words = Array.isArray(text) ? text : String(text).split(/\s+/).filter(Boolean);
    words.forEach(function (word) {
      var trial = lines.length ? lines[lines.length - 1] + " " + word : word;
      if (lines.length && fits(trial)) lines[lines.length - 1] = trial;
      else lines.push(word);
    });
    return lines;
  },
  /* A title's words, a parenthesised span held as one, as ctx.viz.annotate.fit_title and
     ctx.viz.axes.screen_title hold a unit: split at its spaces, "(log2(count + 1))" left
     "1))" alone on a line (M3.6). */
  words: function (text) {
    var out = [], word = "", depth = 0;
    Array.from(String(text)).forEach(function (c) {
      if (/\s/.test(c) && depth <= 0) {
        if (word) out.push(word);
        word = "";
        return;
      }
      depth += (c === "(") - (c === ")");
      word += c;
    });
    if (word) out.push(word);
    return out;
  },
  /* A copy of plotly data or layout as plain values: a typed array becomes an array. */
  plain: function (value) {
    if (Array.isArray(value) || ArrayBuffer.isView(value)) {
      return Array.prototype.map.call(value, ctxExport.plain);
    }
    if (value && typeof value === "object") {
      var out = {};
      Object.keys(value).forEach(function (k) { out[k] = ctxExport.plain(value[k]); });
      return out;
    }
    return value;
  },
  /* Sets a plotly attribute path ("shapes[2].name") on a plain copy; null or undefined, as
     plotly's relayout takes them, removes it. */
  put: function (o, path, value) {
    var keys = path.split(/[.[\]]+/).filter(Boolean), last = keys.pop();
    keys.forEach(function (k, i) {
      if (!o[k] || typeof o[k] !== "object") o[k] = /^\d+$/.test(keys[i + 1] || last) ? [] : {};
      o = o[k];
    });
    if (value === null || value === undefined) delete o[last];
    else o[last] = ctxExport.plain(value);
  },
  /* Each trace of a part as a plain copy, the part's built restyle pairs set on it. */
  traces: function (part) {
    var data = part.data.map(ctxExport.plain);
    (part.built ? part.built.restyle : []).forEach(function (pair) {
      pair[1].forEach(function (at, j) {
        Object.keys(pair[0]).forEach(function (k) { ctxExport.put(data[at], k, pair[0][k][j]); });
      });
    });
    return data;
  },
  /* A length, or a list of lengths, times factor. */
  scale: function (value, factor) {
    if (typeof value === "number") return value * factor;
    if (Array.isArray(value)) return value.map(function (v) { return v * factor; });
    return value;
  },
  /* Little-endian float32 x, y pairs in base64 (ScatterData.export_layers) as two arrays. */
  points: function (encoded) {
    var bytes = Uint8Array.from(atob(encoded), function (c) { return c.charCodeAt(0); });
    var view = new DataView(bytes.buffer), x = [], y = [];
    for (var at = 0; at + 8 <= bytes.length; at += 8) {
      x.push(view.getFloat32(at, true)); y.push(view.getFloat32(at + 4, true));
    }
    return { x: x, y: y };
  },
  /* A plotly dash name as the figure files draw it: matplotlib's on and off lengths in pt per
     pt of line width (style.DASH_PATTERNS); any other dash unchanged. */
  dash: function (value, width, dashes) {
    var pattern = dashes && dashes[value];
    if (!pattern) return value;
    return pattern.map(function (v) { return v * (width || 1) + "px"; }).join(",");
  },
  /* A line's width back in pt, and its dash drawn as the figure files draw it. */
  line: function (line, lines, dashes) {
    if (!line) return;
    line.width = ctxExport.scale(line.width, lines);
    if (typeof line.dash === "string") line.dash = ctxExport.dash(line.dash, line.width, dashes);
  },
  /* Band edges from a heatmap axis's values: as given where there is one more value than
     cells (the rows' edges), else midway between centres, the ends half a step out. */
  edges: function (values, n) {
    var v = Array.prototype.slice.call(values || []);
    if (!v.length) v = Array.from({ length: n }, function (_, i) { return i; });
    if (v.length === n + 1) return v;
    var out = [v[0] - (v.length > 1 ? (v[1] - v[0]) / 2 : 0.5)];
    for (var i = 0; i + 1 < v.length; i++) out.push((v[i] + v[i + 1]) / 2);
    out.push(v[v.length - 1] + (v.length > 1 ? (v[v.length - 1] - v[v.length - 2]) / 2 : 0.5));
    return out;
  },
  /* A heatmap trace as vector cells (HeatmapData.export_layers): each run of equal z along a
     row one filled rectangle, the rectangles of one z one scatter trace in colours[z], none
     for a missing z. plotly's SVG draws a heatmap as one raster image; the figure files draw
     vector cells. */
  cells: function (trace, colours) {
    var z = trace.z || [], rows = z.length, cols = rows ? z[0].length : 0;
    var xe = ctxExport.edges(trace.x, cols), ye = ctxExport.edges(trace.y, rows), by = {};
    for (var r = 0; r < rows; r++) {
      for (var c = 0; c < cols;) {
        var v = z[r][c], end = c + 1;
        while (end < cols && z[r][end] === v) end++;
        if (v !== null && v !== undefined && colours[v] !== undefined) {
          var p = by[v] || (by[v] = { x: [], y: [] });
          p.x.push(xe[c], xe[end], xe[end], xe[c], xe[c], null);
          p.y.push(ye[r], ye[r], ye[r + 1], ye[r + 1], ye[r], null);
        }
        c = end;
      }
    }
    return Object.keys(by).map(Number).sort(function (a, b) { return a - b; }).map(function (v) {
      return { type: "scatter", mode: "none", fill: "toself", fillcolor: colours[v],
               x: by[v].x, y: by[v].y, xaxis: trace.xaxis, yaxis: trace.yaxis,
               showlegend: false, hoverinfo: "skip" };
    });
  },
  /* A label as the figure files place it: on its point, offset in pt, a leader line to it. */
  label: function (l, ex, layout) {
    function at(value, axis) { return (layout[axis] || {}).type === "log" ? Math.log10(value) : value; }
    return {
      x: at(l.x, "xaxis"), y: at(l.y, "yaxis"), xref: "x", yref: "y", text: ctxExport.escape(l.text),
      showarrow: true, arrowhead: 0, arrowwidth: ex.leader, arrowcolor: ex.ink, standoff: 0,
      ax: l.dx, ay: -l.dy, axref: "pixel", ayref: "pixel", xanchor: l.anchor, yanchor: "bottom",
      font: { size: ex.label_size, color: ex.ink }
    };
  },
  /* The figure to draw: every trace of the page's plots as they stand, marks back at the
     figure files' sizes (export.marker turns a mark's page px into pt, and each plot's
     layout.meta.zoom, the zoom it is drawn at, is undone: 2 opened alone, 1 on the module page
     and opened alone below the floor), the journal template, export.width_pt wide and height
     tall. What the figure files draw and the page's plot lacks comes back from export: the
     points the page thinned, the labels it leaves out, the parallel sets' outer margins. A
     second plot, a linked view's parallel sets, goes under the first at cfg.above and
     cfg.below. Legend keys are opaque, as the figure files draw them, whatever their points'
     opacity. Names a phone's layout wrapped are drawn as built (part.built, the fit's
     div.ctxBuilt), and an x-axis title the page wrapped (layout.meta.xtitle). */
  figure: function (parts, cfg, template, height, dashes) {
    var ex = cfg.export, data = [];
    function zoomOf(part) { return (part.layout.meta && part.layout.meta.zoom) || 1; }
    var lines = 1 / zoomOf(parts[0]);
    var layout = ctxExport.plain(parts[0].layout);
    var relayout = (parts[0].built || {}).relayout || {};
    Object.keys(relayout).forEach(function (k) { ctxExport.put(layout, k, relayout[k]); });
    var built = layout.meta && layout.meta.xtitle;
    if (typeof built === "string" && layout.xaxis && layout.xaxis.title) {
      layout.xaxis.title.text = built;
    }
    var heat = 0;
    parts.forEach(function (part, i) {
      var zoom = zoomOf(part), marks = ex.marker / zoom, widths = 1 / zoom;
      ctxExport.traces(part).forEach(function (t, k) {
        if (i === 0 && ex.cells && t.type === "heatmap" && ex.cells[heat]) {
          ctxExport.cells(t, ex.cells[heat++]).forEach(function (f) { data.push(f); });
          return;
        }
        var more = i === 0 && (ex.thinned || {})[k];
        if (more) {
          var xy = ctxExport.points(more);
          t.x = (t.x || []).concat(xy.x); t.y = (t.y || []).concat(xy.y);
        }
        if (t.marker) {
          t.marker.size = ctxExport.scale(t.marker.size, marks);
          if (t.marker.line) t.marker.line.width = ctxExport.scale(t.marker.line.width, widths);
        }
        ctxExport.line(t.line, widths, dashes);
        if (i > 0) t.domain = { x: [0, 1], y: cfg.below };
        data.push(t);
        var faint = t.marker && typeof t.marker.opacity === "number" && t.marker.opacity < 1;
        if (faint && t.showlegend !== false && !Array.isArray(t.marker.color)) {
          var group = t.legendgroup || "key-" + data.length;
          t.showlegend = false; t.legendgroup = group;
          data.push({ type: t.type || "scatter", mode: "markers", x: [null], y: [null], name: t.name,
                      legendgroup: group, hoverinfo: "skip",
                      marker: Object.assign({}, t.marker, { opacity: 1 }) });
        }
      });
    });
    if (parts.length > 1) layout.yaxis = Object.assign(layout.yaxis || {}, { domain: cfg.above });
    (layout.shapes || []).forEach(function (s) { ctxExport.line(s.line, lines, dashes); });
    ["template", "width", "height", "autosize", "margin", "selections", "dragmode", "meta"]
      .forEach(function (k) { delete layout[k]; });
    if (ex.sides) layout.margin = { l: ex.sides.l, r: ex.sides.r };
    if (ex.labels && ex.labels.length) {
      layout.annotations = (layout.annotations || []).concat(ex.labels.map(function (l) {
        return ctxExport.label(l, ex, layout);
      }));
    }
    /* The figure files' layout where the page draws another (a stacked box's rows, as
       ctx.viz.box.export_rows writes them): each attribute path set as written. */
    Object.keys(ex.relayout || {}).forEach(function (path) {
      ctxExport.set(layout, path, ex.relayout[path]);
    });
    layout.template = template;
    layout.width = ex.width_pt;
    layout.height = height;
    return { data: data, layout: layout };
  },
  /* One plotly attribute path, "annotations[3].yshift" or "xaxis.ticktext", set in o. */
  set: function (o, path, value) {
    var keys = path.split(/[.[\]]+/).filter(Boolean), last = keys.pop();
    keys.forEach(function (k) {
      if (o[k] === undefined || o[k] === null) o[k] = {};
      o = o[k];
    });
    o[last] = value;
  },
  /* Browser only: the drawing with its legend ex.lift pt over the highest label, as the
     figure files lift theirs (ctx.viz.box.stacking), where stacked labels rise into it. The
     legend stays where plotly puts it while it clears them. Otherwise it goes to the top of
     the drawing, and the plot's top margin grows by what keeps the labels clear: a label
     anchored over the boxes moves down by (1 - a) of each pt the plot's top moves down,
     where a is the share of the y axis over its anchor. plotly sets margins and labels at
     whole units, which left the gap 0.75 pt once, so the drawing is measured again after
     each move, three times at most. Measured on the drawing, as the files measure theirs,
     so no second copy of plotly's legend or margins exists here. */
  lift: function (spec, ex) {
    if (!ex.lift) return Promise.resolve(spec);
    var holder = document.createElement("div");
    holder.setAttribute("aria-hidden", "true");
    holder.style.cssText = "position:fixed;left:0;top:0;visibility:hidden;pointer-events:none";
    document.body.appendChild(holder);
    function done() { Plotly.purge(holder); holder.remove(); return spec; }
    /* How far the highest label is short of ex.lift under a legend at the drawing's top;
       null where the legend as it stands clears it. */
    function short() {
      var origin = holder.getBoundingClientRect().top, legend = holder.querySelector(".legend rect.bg");
      var notes = Array.from(holder.querySelectorAll(".annotation text")).map(function (t) {
        return t.getBoundingClientRect().top - origin;
      });
      if (!legend || !notes.length) return null;
      var box = legend.getBoundingClientRect(), highest = Math.min.apply(null, notes);
      if (box.bottom - origin + ex.lift <= highest) return null;
      return box.bottom - box.top + ex.lift - highest;
    }
    function move(tries) {
      var gap = short();
      if (gap === null || !tries) return done();
      var full = holder._fullLayout, range = full.yaxis.range;
      var a = (range[1] - spec.layout.annotations[0].y) / (range[1] - range[0]);
      spec.layout.legend = Object.assign({}, spec.layout.legend,
                                         { yref: "container", y: 1, yanchor: "top" });
      var top = Math.ceil(full._size.t + Math.max(0, gap) / (1 - a));
      spec.layout.margin = Object.assign({}, spec.layout.margin, { t: top });
      return Plotly.relayout(holder, { legend: ctxExport.plain(spec.layout.legend),
                                       margin: ctxExport.plain(spec.layout.margin) })
        .then(function () { return move(tries - 1); });
    }
    /* Copies: plotly writes its autoranges back into the layout it is handed. react, as
       newPlot on an empty div: the page's readers find each figure by its newPlot call. */
    return Plotly.react(holder, ctxExport.plain(spec.data), ctxExport.plain(spec.layout),
                        { staticPlot: true })
      .then(function () { return move(3); })
      .catch(function (err) { done(); throw err; });
  },
  /* The caption under the drawing: the figure's caption, the live line naming what the
     reader set, and the note that the file is the page's drawing of that view, each closed
     by a stop; the linked view's live line has none on the page. */
  captionLines: function (ex, view, fits) {
    var parts = [ex.caption, view, ex.note].map(function (part) {
      part = String(part || "").trim();
      return !part || /[.!?]$/.test(part) ? part : part + ".";
    });
    return ctxExport.wrap(parts.filter(Boolean).join(" "), fits);
  },
  /* The caption block's height in pt: its lines at the caption size and line spacing, and the
     inset under it that the figure files keep. */
  captionHeight: function (n, ex) {
    return n * ex.size * ex.spacing + ex.bottom;
  },
  escape: function (s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  },
  /* The SVG file: plotly's drawing, sized in pt as the figure files are, one user unit to the
     point, and the caption under it in ink, a text element per line. */
  compose: function (plot, lines, ex) {
    /* plotly edges each parallel-sets band in lightgray and each of its colour segments in
       black, both at 0.2, a colour and a width no style token names; the figure files draw
       bands with no edge (LINE_WIDTHS band_edge). */
    plot = plot.replace(/ stroke="(?:lightgray|black)" stroke-width="0\.2"/g, ' stroke="none"');
    /* plotly draws an annotation's leader as dashes 0, 0, then its own length on and off: a
       solid line written as a dash pattern no figure file has. */
    plot = plot.replace(/ stroke-dasharray: 0(?:px)?, 0(?:px)?, ([\d.]+)(?:px)?, \1(?:px)?;/g, "");
    var open = plot.match(/<svg[^>]*>/)[0], w = ex.width_pt, h = ex.height_pt;
    var root = open
      .replace(/ width="[^"]*"/, ' width="' + w + 'pt"')
      .replace(/ height="[^"]*"/, ' height="' + h + 'pt"')
      .replace(/ viewBox="[^"]*"/, ' viewBox="0 0 ' + w + " " + h + '"');
    var pitch = ex.size * ex.spacing, top = h - ctxExport.captionHeight(lines.length, ex);
    var style = "font-family: " + ex.family + "; font-size: " + ex.size + "px; fill: " + ex.ink;
    var text = lines.map(function (line, i) {
      var baseline = top + i * pitch + ex.size;
      return '<text x="' + ex.inset * w + '" y="' + baseline + '" style="' + style + '">' +
        ctxExport.escape(line) + "</text>";
    }).join("");
    var end = plot.lastIndexOf("</svg>");
    return root + plot.slice(open.length, end) + '<g class="caption">' + text + "</g></svg>";
  },
  /* The SVG as the PDF reads it: every text set in the embedded face, which svg2pdf would
     otherwise swap for its own Helvetica when the first name of the chain is not loaded. */
  forPdf: function (svg, face) {
    return svg.replace(/font-family:\s*[^;"]+/g, "font-family: " + face);
  },
  /* A line's width at size, as ctx.viz.metrics.text_width measures it from the same numbers
     (metrics.table): the advances, then the kerning of each pair, in the unit of size. */
  width: function (text, size, metrics) {
    var chars = Array.from(String(text)), total = 0, kerned = 0;
    chars.forEach(function (c) {
      var advance = metrics.advances[c];
      total += advance === undefined ? metrics.missing : advance;
    });
    for (var i = 0; i + 1 < chars.length; i++) kerned += metrics.kern[chars[i] + chars[i + 1]] || 0;
    return size * (total + kerned) / metrics.per_em;
  },
  /* Whether a caption line fits the width the figure files wrap captions to, measured as they
     measure it (ctx.viz.annotate.place_caption), so the view's caption breaks where theirs does. */
  fits: function (ex, metrics) {
    var room = ex.width_pt * (1 - 2 * ex.inset);
    return function (line) { return ctxExport.width(line, ex.size, metrics) <= room; };
  },
  /* Browser only: the PDF or SVG of a figure's view as it stands, as a Blob. */
  draw: function (fig, cfg, ext) {
    var setup = JSON.parse(document.getElementById("ctx-export").textContent);
    var plots = [fig.querySelector(".fig-plot .js-plotly-plot"),
                 fig.querySelector(".fig-below .js-plotly-plot")].filter(Boolean);
    var live = fig.querySelector("[aria-live]"), ex = cfg.export;
    var lines = ctxExport.captionLines(ex, live ? live.textContent : "",
                                       ctxExport.fits(ex, setup.metrics));
    var height = ex.height_pt - ctxExport.captionHeight(lines.length, ex);
    var spec = ctxExport.figure(plots.map(function (d) {
      return { data: d.data, layout: d.layout, built: d.ctxBuilt ? d.ctxBuilt() : null };
    }),
                                cfg, setup.template, height, setup.dashes);
    return ctxExport.lift(spec, ex)
      .then(function (spec) {
        return Plotly.toImage(spec, { format: "svg", width: ex.width_pt, height: height });
      })
      .then(function (url) {
        var svg = ctxExport.compose(decodeURIComponent(url.slice(url.indexOf(",") + 1)), lines, ex);
        if (ext === "svg") return new Blob([svg], { type: "image/svg+xml" });
        return ctxExport.pdf(svg, ex, setup);
      });
  },
  /* Browser only: the composed SVG drawn into a PDF of its own size by svg2pdf, with Ctx Sans
     regular and bold embedded, and only the fonts the drawing sets. */
  pdf: function (svg, ex, setup) {
    var w = ex.width_pt, h = ex.height_pt;
    var doc = new window.jspdf.jsPDF({ unit: "pt", format: [w, h], compress: true,
                                       orientation: w > h ? "landscape" : "portrait",
                                       putOnlyUsedFonts: true });
    Object.keys(setup.fonts).forEach(function (style) {
      var file = setup.names[style] + ".ttf";
      doc.addFileToVFS(file, setup.fonts[style]);
      doc.addFont(file, setup.face, style);
      /* jsPDF names an embedded font by its family; each style takes its PostScript name. */
      doc.internal.getFont(setup.face, style).fontName = setup.names[style];
    });
    doc.setFont(setup.face, "normal");
    /* jsPDF writes a fill or stroke colour at two decimals, 1/255 off the style colours; a
       channel passed as a string it writes as given, here at four, as the SVG keeps them. */
    ["setFillColor", "setDrawColor"].forEach(function (name) {
      var set = doc[name];
      doc[name] = function (r, g, b, k) {
        if (typeof r !== "number" || typeof g !== "number" || typeof b !== "number" ||
            k !== undefined) return set.apply(doc, arguments);
        return set.call(doc, (r / 255).toFixed(4), (g / 255).toFixed(4), (b / 255).toFixed(4));
      };
    });
    var holder = document.createElement("div");
    holder.setAttribute("aria-hidden", "true");
    holder.style.cssText = "position:fixed;left:0;top:0;visibility:hidden;pointer-events:none";
    var el = new DOMParser().parseFromString(ctxExport.forPdf(svg, setup.face), "image/svg+xml")
      .documentElement;
    holder.appendChild(el);
    document.body.appendChild(holder);
    return doc.svg(el, { x: 0, y: 0, width: w, height: h }).then(function () {
      holder.remove();
      return doc.output("blob");
    }, function (err) { holder.remove(); throw err; });
  },
  /* Browser only: hand the reader a file. */
  save: function (blob, name) {
    var a = document.createElement("a"), url = URL.createObjectURL(blob);
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
  }
};
{% endraw %}
