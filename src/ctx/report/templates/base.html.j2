<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<script>
/* Resolve the theme before first paint: the reader's stored choice, else the OS preference. */
(function () {
  var root = document.documentElement, theme = null;
  root.classList.add("js");
  try { theme = localStorage.getItem("ctx-theme"); } catch (e) {}
  if (theme !== "white" && theme !== "black") {
    theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "black" : "white";
  }
  root.setAttribute("data-theme", theme);
})();
</script>
<style>
/* Fallbacks first: with JavaScript off no data-theme is ever set, and the page must still read. */
:root { {{ css.layout }} {{ css.white }} color-scheme: light; }
@media (prefers-color-scheme: dark) { :root:not([data-theme]) { {{ css.black }} color-scheme: dark; } }
:root[data-theme="white"] { {{ css.white }} color-scheme: light; }
:root[data-theme="black"] { {{ css.black }} color-scheme: dark; }
{% include "_page.css.j2" %}
</style>
<script>{{ plotly_js }}</script>
</head>
<body>
<a class="skip" href="#main">Skip to the content</a>
<header class="topbar"><div class="topbar-inner">
<p class="brand"><span class="dot" aria-hidden="true"></span>{{ heading.suite }}{% if heading.dataset %} <small>{{ heading.dataset }}</small>{% endif %}</p>
<button id="ctx-theme-toggle" type="button" aria-label="Switch between light and dark"><span class="t-light">Light</span><span class="t-sep">/</span><span class="t-dark">Dark</span></button>
</div></header>
<div class="page{% block page_class %}{% endblock %}">
{% block rail %}{% endblock %}
<main class="content" id="main">
<header class="masthead">
<p class="kicker">{{ heading.kicker }}</p>
<h1>{{ heading.headline }}</h1>
{% if heading.dataset %}<p class="deck">Dataset <strong>{{ heading.dataset }}</strong></p>{% endif %}
{% block deck %}{% endblock %}
</header>
{% block content %}{% endblock %}
</main>
</div>
<script type="application/json" id="ctx-templates">{{ templates }}</script>
<script>
{% include "_page.js.j2" %}
</script>
</body>
</html>
