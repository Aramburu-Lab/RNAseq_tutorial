{% include "_hover.js.j2" %}
{% include "_calls.js.j2" %}
{% include "_brush.js.j2" %}
{% include "_filter.js.j2" %}
{% include "_export.js.j2" %}
{% include "_glossary.js.j2" %}
{% raw %}
/* One script for every page kind. Each block runs inside its own guard, so a failure in one
   is logged and never stops the others; every feature degrades to a readable page without
   JavaScript. */
(function () {
  "use strict";
  function guard(name, block) {
    try { block(); } catch (e) { if (window.console) console.error("ctx page: " + name, e); }
  }
  var root = document.documentElement;
  var templates = JSON.parse(document.getElementById("ctx-templates").textContent);
  /* Opened alone, the page's own templates, for a plot drawn at the page's size (fit). */
  var paged = document.getElementById("ctx-templates-page");
  var pageTemplates = paged ? JSON.parse(paged.textContent) : templates;
  var toggle = document.getElementById("ctx-theme-toggle");
  function plots(scope) { return (scope || document).querySelectorAll(".js-plotly-plot"); }
  /* A plot's template in a theme: at the zoom it is drawn at, which its layout.meta.zoom
     gives opened alone, 1 where it is drawn at the page's size. */
  function template(div, theme) {
    var meta = div.layout && div.layout.meta;
    return (meta && meta.zoom === 1 ? pageTemplates : templates)[theme];
  }
  function retheme(theme) {
    if (!window.Plotly) return;
    plots().forEach(function (d) { Plotly.relayout(d, { template: template(d, theme) }); });
  }

  guard("theme", function () {
    function apply(theme, redraw) {
      root.setAttribute("data-theme", theme);
      toggle.setAttribute("aria-pressed", theme === "black" ? "true" : "false");
      if (redraw) retheme(theme);
    }
    toggle.addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "black" ? "white" : "black";
      try { localStorage.setItem("ctx-theme", next); } catch (e) {}
      apply(next, true);
    });
    /* Figures are drawn with the light template baked in; only a dark start needs a relayout. */
    var start = root.getAttribute("data-theme");
    apply(start, start === "black");
    /* Paper is white: print with the light figures, then restore the reader's theme. */
    window.addEventListener("beforeprint", function () { retheme("white"); });
    window.addEventListener("afterprint", function () { retheme(root.getAttribute("data-theme")); });
  });

  /* Glossary terms: a tooltip per marked term; on the glossary page, the search box. */
  guard("tooltips", function () { ctxGlossary.tips(document, window); });
  guard("glossary search", function () { ctxGlossary.search(document); });

  /* Tabs: every panel drew visible at full width; hide the inactive ones only now, and resize
     a panel's plot when it is shown, so plotly never lays out a hidden div. */
  document.querySelectorAll("[role=tablist]").forEach(function (list) {
    guard("tabs", function () {
      var tabs = Array.prototype.slice.call(list.querySelectorAll("[role=tab]"));
      function show(tab) {
        tabs.forEach(function (t) {
          var on = t === tab, panel = document.getElementById(t.getAttribute("aria-controls"));
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.tabIndex = on ? 0 : -1;
          if (!panel) return;
          panel.hidden = !on;
          if (on && window.Plotly) plots(panel).forEach(function (d) { Plotly.Plots.resize(d); });
        });
      }
      tabs.forEach(function (tab, i) {
        tab.addEventListener("click", function () { show(tab); });
        tab.addEventListener("keydown", function (e) {
          var step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          var next = tabs[(i + step + tabs.length) % tabs.length];
          show(next); next.focus();
        });
      });
      show(tabs[0]);
    });
  });

  /* The clipboard API is refused on some file:// pages; selecting the text lets the reader
     copy it by hand. */
  document.querySelectorAll("button[data-copy]").forEach(function (button) {
    guard("copy", function () {
      var code = document.getElementById(button.getAttribute("data-copy"));
      var label = button.textContent;
      function select() {
        var range = document.createRange(); range.selectNodeContents(code);
        var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
        button.textContent = button.getAttribute("data-selected");
      }
      button.addEventListener("click", function () {
        if (!navigator.clipboard || !window.isSecureContext) { select(); return; }
        navigator.clipboard.writeText(code.textContent).then(function () {
          button.textContent = button.getAttribute("data-copied");
          setTimeout(function () { button.textContent = label; }, 1500);
        }, select);
      });
    });
  });

  /* Mark the section being read: the last shown entry whose target is above the top third of
     the window. Sub-entries hidden on a narrow screen are skipped, so a shown one is marked. */
  guard("contents", function () {
    var links = Array.prototype.slice.call(document.querySelectorAll(".toc a"));
    if (!links.length) return;
    var queued = false;
    function mark() {
      queued = false;
      var line = window.innerHeight / 3, current = null;
      links.forEach(function (a) {
        var target = document.getElementById(a.hash.slice(1));
        if (a.getClientRects().length && target && target.getBoundingClientRect().top <= line) {
          current = a;
        }
      });
      links.forEach(function (a) {
        if (a === current) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    }
    window.addEventListener("scroll", function () {
      if (!queued) { queued = true; window.requestAnimationFrame(mark); }
    }, { passive: true });
    window.addEventListener("resize", mark);
    mark();
  });

  /* Live calling: ctxCalls holds the rule; this block reads the controls, redraws the points
     and the cutoffs, and fills the page's own sentence templates with the same numbers the
     Python side fills them with. */
  /* The filter form borrows the calls panel's look (class "calls"), not its script. */
  document.querySelectorAll("form.calls:not(.filter)").forEach(function (form) {
    guard("calls", function () { liveCalls(form); });
  });

  /* Filters: ctxFilter picks the rows; this block redraws every series from them, fits the
     category axis to the bars shown, moves the median line and refills the lead's numbers and
     the live line. */
  document.querySelectorAll("form.filter").forEach(function (form) {
    guard("filter", function () { filtering(form); });
  });

  /* A plot wider than its box scrolls inside it: say so above the plot, and let the keyboard
     reach the box, while it does. */
  guard("scroll", function () {
    document.querySelectorAll(".fig-plot, .fig-below").forEach(function (box) {
      var hint = box.querySelector(".scroll-hint");
      if (!hint) return;
      function check() {
        var over = box.scrollWidth > box.clientWidth + 1;
        hint.hidden = !over;
        if (over) box.setAttribute("tabindex", "0"); else box.removeAttribute("tabindex");
      }
      if (window.ResizeObserver) new ResizeObserver(check).observe(box);
      window.addEventListener("resize", check);
      /* plotly redraws a plot at its box's width a moment after the window changes, which
         resizes no box: opened alone and narrowed, the hint stayed over a plot that fit. */
      box.querySelectorAll(".js-plotly-plot").forEach(function (div) {
        if (div.on) div.on("plotly_afterplot", check);
      });
      check();
    });
  });

  /* Every plot follows its box, through one ResizeObserver on its div and its box (work order
     item 2, 2026-10-07): plotly redraws only on a window's resize, and a scrollbar that appears
     after the first draw narrows every box with none (QC band maps laid out 582 px wide in a
     567 px div). A plot drawn at another width than its div's is redrawn; and the observer
     swaps the layouts a plot names:
     - layout.meta.narrow, a phone's (a heatmap's row labels, legend entries and title wrapped,
       each row as tall as its wrapped label, and the height they need), while the div is
       narrower than narrow.below px; a desktop keeps the figure's own, the static's (work order
       item 2, 2026-10-01).
     - layout.meta.page, opened alone, the module page's own (figures.page_layout), with its
       templates and its box's width, while the box is narrower than page.below, twice a
       phone's plot: there a figure opened alone is drawn as the page draws it (Rytis
       2026-10-07), with page.narrow, the page's phone layout, as on the module page.
     A swap's relayout holds layout keys, plotly's paths among them; its restyle, pairs of a
     trace update and the traces it sets. Where a layout holds its cells' aspect
     (yaxis.scaleanchor), plotly shrank the cells with the width under a fixed height, and M12's
     map stood 49 px blank under its plot at 1,280 px: the figure takes the height its width
     gives the cells instead. */
  guard("fit", function () {
    if (!window.Plotly) return;
    plots().forEach(function (div) { guard("fit", function () { fitting(div); }); });
  });

  /* An x-axis title wider than the room under its plot wraps there, from its own words, a unit
     held whole, so a phone never clips one; on a wider screen it is one line again. The title
     on one line, as the figure files set it, stays in layout.meta.xtitle, which the export
     draws: a view's files take the figure files' width, never the screen's. A title built with
     its unit on a line of its own (axes.screen_title, for a page without the script) is read
     as that one line. */
  guard("titles", function () {
    if (!window.Plotly) return;
    var canvas = document.createElement("canvas").getContext("2d");
    plots().forEach(function (div) {
      var original = null;
      function fit() {
        var full = div._fullLayout, axis = full && full.xaxis;
        if (!axis || !axis.title || !axis.title.text || div.offsetParent === null) return;
        if (original === null) {
          original = String(div.layout.xaxis.title.text || "").replace(/<br>/g, " ");
          div.layout.meta = Object.assign({}, div.layout.meta, { xtitle: original });
        }
        var size = full._size, centre = size.l + size.w / 2;
        var room = 2 * Math.min(centre, full.width - centre);
        canvas.font = axis.title.font.size + "px " + axis.title.font.family;
        var fits = function (line) { return canvas.measureText(line).width <= room; };
        var text = fits(original) ? original
          : ctxExport.wrap(ctxExport.words(original), fits).join("<br>");
        if (text !== axis.title.text) Plotly.relayout(div, { "xaxis.title.text": text });
      }
      div.on("plotly_afterplot", function () { window.requestAnimationFrame(fit); });
      fit();
    });
  });

  /* Linked brushing: ctxBrush holds the logic; this block paints the samples a lasso or a tap
     names, in both traces, and keeps the live line in step. */
  document.querySelectorAll("form.brush").forEach(function (form) {
    guard("brush", function () { brushing(form); });
  });

  function at(o, key) {
    return key.split(/[.[\]]+/).filter(Boolean).reduce(function (o, p) { return o && o[p]; }, o);
  }

  function fitting(div) {
    var meta = div.layout.meta || {}, narrow = meta.narrow, page = meta.page;
    var wrapper = div.parentElement, holder = div.closest(".fig-plot, .fig-below") || wrapper;
    var built = wrapper.style.width, ratio = null;
    /* A layout that holds its cells' aspect through plotly (yaxis.scaleanchor) has it held by
       its height here instead: with an axis shortened to the anchor, plotly's automargin
       stops counting the column labels and the statistic axis drawn inside the plot, and a
       height that followed its margins redrew between two layouts without end. */
    if (div.layout.yaxis && div.layout.yaxis.scaleanchor) {
      ratio = div.layout.yaxis.scaleratio || 1;
      Plotly.relayout(div, { "yaxis.scaleanchor": null });
    }
    function layout(relayout, restyle, small) {
      return { relayout: relayout, restyle: restyle || [], small: !!small };
    }
    var own = layout({}, []);
    var phone = narrow ? layout(narrow.relayout, narrow.restyle) : null;
    var small = page ? layout(Object.assign({ "meta.zoom": 1 }, page.relayout), page.restyle, true)
      : null;
    var smallPhone = page && page.narrow ? layout(
      Object.assign({ "meta.zoom": 1 }, page.relayout, page.narrow.relayout),
      page.restyle.concat(page.narrow.restyle || []), true) : null;
    /* What any swap sets, as the figure was built, to set back. */
    var wide = {};
    [own, phone, small, smallPhone].filter(Boolean).forEach(function (s) {
      Object.keys(s.relayout).forEach(function (k) { wide[k] = ctxExport.plain(at(div.layout, k)); });
      s.unstyle = s.restyle.map(function (pair) {
        var update = {};
        Object.keys(pair[0]).forEach(function (k) {
          update[k] = pair[1].map(function (i) { return ctxExport.plain(at(div.data[i], k)); });
        });
        return [update, pair[1]];
      });
    });
    var state = own, resizedAt = null, heightSet = null, swapping = false;
    /* The layout for the box as it is. Below the floor the box takes the module page's
       width first, and a phone's layout follows the plot's width there. */
    function pick() {
      var box = holder.clientWidth;
      if (!box) return null;
      var below = !!page && box < page.below, css = below ? page.width : built;
      if (wrapper.style.width !== css) wrapper.style.width = css;
      var width = div.getBoundingClientRect().width;
      if (below) return smallPhone && width < page.narrow.below ? smallPhone : small;
      return phone && width < narrow.below ? phone : own;
    }
    /* The div and plotly's wrapper keep the height they were written with; both take the
       plot's new one. */
    function heights(h) {
      [div, wrapper].forEach(function (e) { if (e.style.height) e.style.height = h + "px"; });
    }
    /* plotly draws, and says so, inside each restyle and relayout here: the plot's state is
       the new one before the first, and the draws it says it made wait for the last. */
    function swap(next) {
      var last = state, update = {};
      state = next; resizedAt = null; heightSet = null; swapping = true;
      try {
        Object.keys(last.relayout).forEach(function (k) { update[k] = wide[k]; });
        Object.assign(update, next.relayout);
        if (next.small !== last.small) {
          var theme = root.getAttribute("data-theme");
          update.template = (next.small ? pageTemplates : templates)[theme];
        }
        last.unstyle.forEach(function (pair) { Plotly.restyle(div, pair[0], pair[1]); });
        next.restyle.forEach(function (pair) { Plotly.restyle(div, pair[0], pair[1]); });
        /* A plot whose margins outgrow its height stops plotly ("Something went wrong with axis
           scaling"): a taller figure takes its height before its new type, a shorter one
           after, as a heatmap opened alone narrowed to the page's size did. */
        var height = update.height, grows = height !== undefined && height > div._fullLayout.height;
        delete update.height;
        if (grows) setHeight(height);
        /* plotly pins the width it drew at when a relayout sets the height, and then never
           redraws the plot at its box's width again: autosize, and no width, keep it free. */
        Plotly.relayout(div, Object.assign({ autosize: true, width: null }, update));
        if (height !== undefined && !grows) setHeight(height);
        /* plotly.js sets a legend key's offset only when it first draws the key, from the key's
           width then: drawn at the page's size, a figure opened alone kept its keys 15 px into
           their names until its legend was drawn anew. */
        if (next.small !== last.small && div._fullLayout.showlegend) {
          var shown = div.layout.showlegend;
          Plotly.relayout(div, { showlegend: false });
          Plotly.relayout(div, { showlegend: shown === undefined ? null : shown });
        }
      } finally {
        swapping = false;
      }
    }
    function setHeight(height) {
      heights(height);
      Plotly.relayout(div, { height: height, autosize: true, width: null });
    }
    /* The height that holds the cells' aspect at the width drawn, in the layouts that hold it
       (the figure's own and the page's; a phone's rows keep their heights): the margins as
       drawn, which no anchor shortens, and the rows' span at the ratio of a column's px. */
    function held() {
      var x = div.layout.xaxis, y = div.layout.yaxis, full = div._fullLayout;
      if (ratio === null || (state !== own && state !== small) || !full) return null;
      var size = full._size;
      return size.t + size.b + ratio * size.w * Math.abs(y.range[1] - y.range[0]) /
        Math.abs(x.range[1] - x.range[0]);
    }
    function apply() {
      if (swapping) return;
      var next = pick(), full = div._fullLayout;
      if (!next || !full) return;
      if (next !== state) swap(next);
      full = div._fullLayout;
      var width = div.getBoundingClientRect().width;
      /* Once per width, so a width plotly cannot draw at never loops. */
      if (Math.abs(full.width - width) > 0.5 && resizedAt !== width) {
        resizedAt = width;
        Plotly.Plots.resize(div);
        return;
      }
      var height = held();
      if (height !== null && Math.abs(height - full.height) > 1 && heightSet !== height) {
        heightSet = height;
        setHeight(height);
      }
    }
    if (window.ResizeObserver) {
      var watch = new ResizeObserver(apply);
      watch.observe(div);
      watch.observe(holder);
    }
    window.addEventListener("resize", apply);
    div.on("plotly_afterplot", apply);
    apply();
  }

  /* A figure's PDF and SVG buttons: the figure files while its controls are at their
     defaults; once one is moved, the view as set, drawn by ctxExport. Each control's wiring
     calls the switch this returns with whether the view is moved (D-033). Moved, a button
     links no file, so no middle click, new tab or "Save link as" reaches the default file
     under a label that names the view. */
  function exporting(fig, cfg) {
    var links = Array.prototype.slice.call(fig.querySelectorAll("a[data-export]"));
    var moved = false;
    if (!cfg.export || !window.jspdf || !links.length) return function () {};
    var reference = links.map(function (a) {
      return [a.textContent, a.getAttribute("title"), a.getAttribute("href")];
    });
    links.forEach(function (a) {
      a.addEventListener("click", function (e) {
        if (!moved) return;
        e.preventDefault();
        var ext = a.getAttribute("data-export");
        ctxExport.draw(fig, cfg, ext).then(function (blob) {
          ctxExport.save(blob, cfg.export.file + "_view." + ext);
        }, function (err) { if (window.console) console.error("ctx page: export", err); });
      });
      a.addEventListener("keydown", function (e) {
        if (moved && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); a.click(); }
      });
    });
    return function (on) {
      moved = on;
      links.forEach(function (a, i) {
        a.textContent = on ? a.getAttribute("data-view") : reference[i][0];
        a.setAttribute("title", on ? a.getAttribute("data-view-title") : reference[i][1]);
        if (on) {
          a.removeAttribute("href"); a.setAttribute("role", "button"); a.setAttribute("tabindex", "0");
        } else {
          a.setAttribute("href", reference[i][2]); a.removeAttribute("role"); a.removeAttribute("tabindex");
        }
      });
    };
  }

  function brushing(form) {
    var fig = form.closest(".fig");
    var cfg = JSON.parse(document.getElementById(form.getAttribute("data-controls")).textContent);
    var rows = JSON.parse(document.getElementById(form.getAttribute("data-rows")).textContent);
    /* The scatter beside the reading guide; the parallel sets under both, across the card. */
    var div = fig.querySelector(".fig-plot .js-plotly-plot");
    var sets = fig.querySelector(".fig-below .js-plotly-plot") || div;
    var summary = fig.querySelector(".brush-summary");
    var mark = exporting(fig, cfg);
    var painted = ctxBrush.start(rows.length);
    /* A painted sample shows its paint at full strength: the lasso's own dimming of the
       samples it missed, and its outline, go once the paint is laid. */
    function draw() {
      Plotly.restyle(div, { "marker.color": [ctxBrush.markers(painted, cfg)],
                            selectedpoints: [null] }, [cfg.scatter]);
      Plotly.relayout(div, { selections: [] });
      Plotly.restyle(sets, { "line.color": [ctxBrush.codes(painted)] }, [cfg.parcats]);
      summary.textContent = ctxBrush.summary(painted, rows, cfg);
      mark(ctxBrush.moved(painted));
    }
    function paint(event) {
      var picked = ctxBrush.indices(event);
      if (!picked.length) return;
      painted = ctxBrush.paint(painted, picked, Number(form.elements.colour.value));
      draw();
    }
    div.on("plotly_selected", paint);
    div.on("plotly_click", paint);
    if (sets !== div) sets.on("plotly_click", paint);
    form.querySelector("[data-clear]").addEventListener("click", function () {
      painted = ctxBrush.clear(painted);
      draw();
    });
    form.addEventListener("submit", function (e) { e.preventDefault(); });
  }

  function filtering(form) {
    var fig = form.closest(".fig");
    var cfg = JSON.parse(document.getElementById(form.getAttribute("data-controls")).textContent);
    var rows = JSON.parse(document.getElementById(form.getAttribute("data-rows")).textContent);
    var div = fig.querySelector(".js-plotly-plot");
    var summary = fig.querySelector(".filter-summary");
    var lead = fig.querySelector(".fig-lead");
    var selects = Array.prototype.slice.call(form.querySelectorAll("select[data-column]"));
    var axis = cfg.horizontal ? "yaxis" : "xaxis", along = cfg.horizontal ? "x" : "y";
    var mark = exporting(fig, cfg);
    var traces = cfg.traces.map(function (_, i) { return i; });
    /* The lead's numbers sit in spans named for their placeholders; only they change, so its
       words and marks stay as built. With nothing to take a number over, the lead hides. */
    function refill(view) {
      if (!cfg.lead || !lead) return;
      var values = view.bars ? ctxFilter.aggregate(rows, view.shown, cfg.lead.aggregates) : null;
      lead.hidden = values === null;
      if (values === null) return;
      lead.querySelectorAll("[data-fill]").forEach(function (span) {
        span.textContent = values[span.getAttribute("data-fill")];
      });
    }
    function update() {
      var chosen = {};
      selects.forEach(function (s) { chosen[s.getAttribute("data-column")] = s.value; });
      var view = ctxFilter.view(rows, cfg, chosen), layout = {}, moved = ctxFilter.moved(chosen);
      Plotly.restyle(div, { x: view.x, y: view.y, customdata: view.customdata }, traces);
      layout[axis + ".categoryarray"] = view.categories;
      layout[axis + ".showticklabels"] = view.categories.length <= cfg.max_tick_labels;
      if (cfg.median_shape !== null) {
        var shape = "shapes[" + cfg.median_shape + "].";
        layout[shape + "visible"] = view.median !== null;
        if (view.median !== null) {
          layout[shape + along + "0"] = view.median;
          layout[shape + along + "1"] = view.median;
        }
      }
      Plotly.relayout(div, layout);
      refill(view);
      summary.textContent = ctxFilter.summary(view, cfg, summary.getAttribute("data-template"),
                                              summary.getAttribute("data-none"), moved);
      mark(moved);
    }
    form.addEventListener("change", update);
    form.addEventListener("submit", function (e) { e.preventDefault(); });
    /* A browser restoring the form on back-navigation sets the selects without an event. */
    update();
  }

  function liveCalls(form) {
    var fig = form.closest(".fig");
    var cfg = JSON.parse(document.getElementById(form.getAttribute("data-controls")).textContent);
    var rows = JSON.parse(document.getElementById(form.getAttribute("data-rows")).textContent);
    var div = fig.querySelector(".js-plotly-plot");
    var reading = fig.querySelectorAll("[data-reading]");
    var summary = fig.querySelector(".calls-summary");
    var fc = form.elements.fc, unit = form.elements.fc_unit;
    var basis = form.elements.basis, cutoff = form.elements.cutoff;
    var mark = exporting(fig, cfg);
    function height(p) { return -Math.log10(Math.max(p, cfg.p_floor)); }
    /* The cutoff lines span the whole plot, thinned points included, as drawn on load. */
    var span = div.data[cfg.cutoff_lines[0]].y, across = div.data[cfg.cutoff_lines[2]].x;
    var ytop = span[1], xmin = across[0], xmax = across[1];
    /* The rounding rule of a unit switch lives in ctxCalls, where the tests run it. */
    var state = { exact: null, shown: null, unit: unit.value };
    function threshold() { return ctxCalls.applied(state, fc.value, unit.value); }
    function fmt(n, digits) { return n.toFixed(digits); }
    function count(n) { return n.toLocaleString("en-US"); }
    function fill(text, values) {
      return text.replace(/\{(\w+)\}/g, function (all, key) {
        return Object.prototype.hasOwnProperty.call(values, key) ? values[key] : all;
      });
    }
    /* A line the reader hid through the legend stays hidden. */
    function shownAs(index, on) {
      if (div.data[index].visible === "legendonly") return "legendonly";
      return on;
    }
    function update(settle) {
      var t = threshold(), alpha = ctxCalls.cutoff(cutoff.value, cfg), column = basis.value;
      if (settle && String(alpha) !== cutoff.value) cutoff.value = String(alpha);
      var found = ctxCalls.call(rows, cfg, t, column, alpha), parts = found.parts;
      var restyled = { x: [], y: [], customdata: [] }, traces = [];
      ["up", "down", "ns"].forEach(function (k) {
        traces.push(cfg.traces[cfg.levels[k]]);
        restyled.x.push(parts[k].map(function (r) { return r[cfg.lfc]; }));
        restyled.y.push(parts[k].map(function (r) { return height(r[cfg.p]); }));
        restyled.customdata.push(parts[k].map(function (r) { return ctxHover.row(r, cfg.hover); }));
      });
      var yline = found.line === null ? null : height(found.line), lines = cfg.cutoff_lines;
      Plotly.restyle(div, restyled, traces);
      Plotly.restyle(div, {
        x: [[t, t], [-t, -t], [Math.min(xmin, -t), Math.max(xmax, t)]],
        y: [[0, ytop], [0, ytop], yline === null ? [null, null] : [yline, yline]],
        visible: [shownAs(lines[0], true), shownAs(lines[1], true),
                  yline === null ? false : shownAs(lines[2], true)]
      }, lines);
      var values = {
        n_tested: count(cfg.n_tested), tested: cfg.tested, reference: cfg.reference,
        fc: fmt(t, 2), fold_up: fmt(Math.pow(2, t), 2), fold_down: fmt(Math.pow(2, -t), 2),
        pct_up: fmt(100 * (Math.pow(2, t) - 1), 1), pct_down: fmt(100 * (1 - Math.pow(2, -t)), 1),
        basis: cfg.bases[column], cutoff: String(alpha),
        y_line: yline === null ? "" : fmt(yline, 2),
        n_up: count(parts.up.length), n_down: count(parts.down.length)
      };
      values.line_rule = fill(yline === null ? cfg.no_line_rule : cfg.line_rule, values);
      reading.forEach(function (li) {
        li.textContent = fill(cfg.reading[Number(li.getAttribute("data-reading"))], values);
      });
      if (summary) summary.textContent = fill(cfg.summary, values);
      mark(ctxCalls.moved(cfg, t, column, alpha));
    }
    unit.addEventListener("change", function () {
      fc.value = ctxCalls.switchUnit(state, fc.value, unit.value);
      update(true);
    });
    function stepCutoff(dir) {
      cutoff.value = String(ctxCalls.step(cutoff.value, dir, cfg));
      update(true);
    }
    cutoff.addEventListener("keydown", function (e) {
      var dir = e.key === "ArrowUp" ? 1 : e.key === "ArrowDown" ? -1 : 0;
      if (dir) { e.preventDefault(); stepCutoff(dir); }
    });
    form.querySelectorAll("[data-step]").forEach(function (b) {
      b.addEventListener("click", function () { stepCutoff(Number(b.getAttribute("data-step"))); });
    });
    form.addEventListener("input", function (e) { if (e.target !== unit) update(false); });
    form.addEventListener("change", function (e) { if (e.target !== unit) update(true); });
    form.addEventListener("submit", function (e) { e.preventDefault(); });
    form.addEventListener("reset", function () {
      setTimeout(function () { state = { exact: null, shown: null, unit: unit.value }; update(true); }, 0);
    });
    update(false);
  }
