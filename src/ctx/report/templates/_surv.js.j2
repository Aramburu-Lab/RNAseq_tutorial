    return { cuts: cuts, thresholds: thresholds, statistic: observed, beaten: beaten, maxima: maxima,
             corrected: (1 + beaten) / (permutations + 1),
             best: cuts[observed.indexOf(best)] };
  },
  /* score.zscores and score.score over the stored int16 values of the selected genes. */
  score: function (rows, signs) {
    var n = rows[0].length, total = new Float64Array(n);
    rows.forEach(function (row, g) {
      var mean = 0, sd = 0, i;
      for (i = 0; i < n; i++) mean += row[i] / ctxSurv.SCALE;
      mean /= n;
      for (i = 0; i < n; i++) { var d = row[i] / ctxSurv.SCALE - mean; sd += d * d; }
      sd = Math.sqrt(sd / n);
      for (i = 0; i < n; i++) total[i] += signs[g] * (row[i] / ctxSurv.SCALE - mean) / sd;
    });
    var m = 0, s = 0, k;
    for (k = 0; k < n; k++) { total[k] /= rows.length; m += total[k]; }
    m /= n;
    for (k = 0; k < n; k++) s += (total[k] - m) * (total[k] - m);
    s = Math.sqrt(s / n);
    return Array.from(total, function (v) { return (v - m) / s; });
  },
  /* score.split: 0 low, 1 high at the median; 0, 1, 2 by tertiles. */
  split: function (values, rule) {
    var cuts = rule === "median" ? [ctxSurv.percentile(values, 50)]
      : [ctxSurv.percentile(values, 100 / 3), ctxSurv.percentile(values, 200 / 3)];
    return values.map(function (v) { return cuts.filter(function (c) { return v >= c; }).length; });
  }
};
