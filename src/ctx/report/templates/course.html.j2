{% extends "base.html.j2" %}
{# A kit's first page: every link is relative and points inside the kit, which may be opened from anywhere. #}
{% macro link(l) %}<li><span class="pill" data-kind="{{ 'real' if l.real else 'made-up' }}">{{ course.real if l.real else course.made_up }}</span><a href="{{ l.href }}">{{ l.label }}</a></li>{% endmacro %}
{% block content %}
{# kit.js sits beside START.html in every kit; failing to load it means this page was copied out alone. #}
<div class="zipped" id="ctx-zipped" role="alert" hidden><strong>{{ course.zipped_title }}</strong> {{ course.zipped }}</div>
<script src="kit.js" onerror="document.getElementById('ctx-zipped').hidden = false"></script>
<section id="course">
{# A lite home page (D-111) keeps its links: the glossary, the guide, the hubs, the modules. #}
{% if not lite %}
<p class="lede">{{ course.intro }}</p>
{% endif %}
{% if page.key_numbers and not lite %}<dl class="keys">{% for k in page.key_numbers %}<div><dt>{{ k.label }}</dt><dd class="key-value">{{ k.value }}</dd>{% if k.detail %}<dd class="key-detail">{{ k.detail }}</dd>{% endif %}</div>{% endfor %}</dl>{% endif %}
{% if not lite %}
<p class="note">{{ course.note }}</p>
<p class="note">{{ course.unzip }}</p>
{% endif %}
{% if page.glossary %}<p class="note"><a href="{{ page.glossary }}">{{ course.glossary }}</a></p>{% endif %}
{% if page.guide %}<p class="note"><a href="{{ page.guide }}">{{ course.guide }}</a></p>{% endif %}
</section>
{% if page.hubs %}
<section class="hub-section" id="hubs">
<h2>{{ course.hubs }}</h2>
{% if not lite %}
<p class="note">{{ course.hubs_lead }}</p>
{% endif %}
<ul class="course-links">{% for l in page.hubs %}{{ link(l) }}{% endfor %}</ul>
</section>
{% endif %}
<section class="hub-section" id="modules">
<h2>{{ course.modules }}</h2>
<ol class="modules">{% for row in page.rows %}<li><span class="kicker">{{ row.number }}</span><span class="module-name">{{ row.name }}</span>{% if row.links %}<ul class="course-links">{% for l in row.links %}{{ link(l) }}{% endfor %}</ul>{% else %}<span class="missing">{{ course.none }}</span>{% endif %}</li>{% endfor %}</ol>
</section>
{% endblock %}
